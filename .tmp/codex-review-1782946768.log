+;; Stage 4 demo: pick an item with tui/select.
+;;
+;; Run from the repo root: LG_SOURCE_PATHS=src lg examples/select_project.lg
+
+(ns examples.select-project
+  (:require [tiny-tui.core :as tui]))
+
+(def projects
+  [{:id 1 :name "tiny-cli"}
+   {:id 2 :name "tiny-tui"}
+   {:id 3 :name "lgx"}])
+
+(defn -main []
+  (let [result (tui/select {:title "Select project"
+                            :items projects
+                            :item->text :name})]
+    (case (:type result)
+      :select (println "Selected:" (:name (:item result)))
+      :cancel (println "Cancelled."))))
+
+(when-not *compiling-aot* (-main))
