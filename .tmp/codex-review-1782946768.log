diff --git a/src/tiny_tui/core.lg b/src/tiny_tui/core.lg
index 6652984..cb11695 100644
--- a/src/tiny_tui/core.lg
+++ b/src/tiny_tui/core.lg
@@ -1,47 +1,80 @@
 ;; tiny-tui.core — the public API.
 ;;
 ;; run: the minimal program loop. An app is three things:
 ;;   :init   initial state (a map)
 ;;   :update (fn [state msg] [new-state event]) — nil event keeps looping,
 ;;           any non-nil event stops the loop
 ;;   :view   (fn [state] string)
 ;;
 ;; run returns [final-state event]. It handles :ctrl-c itself (returns
 ;; event :ctrl-c without consulting :update) and treats :resize as a plain
 ;; redraw. Terminal size is injected as :tui/size before every view call.
 ;;
 ;; Testing hooks (all optional): :read-key-fn, :render-fn, :screen false —
 ;; they let whole flows run headlessly with scripted keys.
 
 (ns tiny-tui.core
   (:require [term]
+            [tiny-tui.help :as help]
             [tiny-tui.key :as key]
-            [tiny-tui.screen :as screen]))
+            [tiny-tui.layout :as layout]
+            [tiny-tui.list :as tlist]
+            [tiny-tui.screen :as screen]
+            [tiny-tui.style :as style]))
 
 (defn- run-loop [opts]
   (let [update-fn (:update opts)
         view (:view opts)
         read-key-fn (or (:read-key-fn opts) key/read)
         render-fn (or (:render-fn opts) screen/render!)]
     (loop [state (:init opts)]
       (let [state (assoc state :tui/size (or (term/size) [80 24]))]
         (render-fn (view state))
         (let [msg (read-key-fn)]
           (cond
             (nil? msg) [state nil]
             (= msg :ctrl-c) [state :ctrl-c]
             (= msg :resize) (recur state)
             :else (let [result (update-fn state msg)
                         next-state (first result)
                         event (second result)]
                     (if (nil? event)
                       (recur next-state)
                       [next-state event]))))))))
 
 (defn run
   "Run a TUI program (see namespace docstring). Returns [final-state event]."
   [opts]
   (if (false? (:screen opts))
     (run-loop opts)
     (screen/with-screen
       (run-loop opts))))
+
+(defn- select-view [opts list-state]
+  (apply layout/vstack
+         (concat
+          (when (:title opts)
+            [(style/bold (:title opts)) ""])
+          [(tlist/view list-state)
+           ""
+           (help/view (tlist/bindings list-state))])))
+
+(defn select
+  "Show a navigable list and return the user's choice:
+     {:type :select :item item :index n}  on enter
+     {:type :cancel}                      on q / esc / Ctrl-C
+   opts: :title, :items, :item->text (see tiny-tui.list/create), plus the
+   run testing hooks (:read-key-fn :render-fn :screen)."
+  [opts]
+  (let [result (run {:init {:list (tlist/create opts)}
+                     :update (fn [state msg]
+                               (let [r (tlist/update (:list state) msg)]
+                                 [(assoc state :list (first r)) (second r)]))
+                     :view (fn [state] (select-view opts (:list state)))
+                     :read-key-fn (:read-key-fn opts)
+                     :render-fn (:render-fn opts)
+                     :screen (:screen opts)})
+        event (second result)]
+    (if (map? event)
+      event
+      {:type :cancel})))
diff --git a/src/tiny_tui/list.lg b/src/tiny_tui/list.lg
new file mode 100644
index 0000000..9796424
--- /dev/null
+++ b/src/tiny_tui/list.lg
@@ -0,0 +1,87 @@
+;; tiny-tui.list — a pure list widget. No pagination, no scrolling (V1
+;; non-goals): state in, [state event] out, string view.
+
+(ns tiny-tui.list
+  (:require [string]
+            [tiny-tui.style :as style]))
+
+(defn create
+  "opts: {:items [...] :item->text fn :empty-text \"...\"
+          :actions [{:id :delete :key \"d\" :label \"delete\"
+                     :destructive? true} ...]}"
+  [opts]
+  {:items (vec (:items opts))
+   :item->text (or (:item->text opts) str)
+   :empty-text (or (:empty-text opts) "No items.")
+   :actions (vec (:actions opts))
+   :cursor 0})
+
+(defn selected-index [l]
+  (when (seq (:items l))
+    (:cursor l)))
+
+(defn selected-item [l]
+  (when (seq (:items l))
+    (nth (:items l) (:cursor l))))
+
+(defn- move [l delta]
+  (let [n (count (:items l))]
+    (if (zero? n)
+      l
+      (assoc l :cursor (min (dec n) (max 0 (+ (:cursor l) delta)))))))
+
+(defn- select-event [l]
+  ;; Keyed off list non-emptiness, not item truthiness — nil/false are
+  ;; legitimate items.
+  (when (seq (:items l))
+    {:type :select
+     :item (selected-item l)
+     :index (:cursor l)}))
+
+(defn- action-event [l action]
+  (when (seq (:items l))
+    (let [event {:type :action
+                 :action (:id action)
+                 :item (selected-item l)
+                 :index (:cursor l)}]
+      (if (:destructive? action)
+        (assoc event :destructive? true)
+        event))))
+
+(defn- action-for-key [l msg]
+  (first (filter (fn [a] (= msg (:key a))) (:actions l))))
+
+(defn update
+  "Returns [new-state event]. Events: {:type :select ...} on enter,
+   {:type :action ...} on an action key, {:type :cancel} on q/esc,
+   nil otherwise. Built-in keys win over action keys."
+  [l msg]
+  (cond
+    (= msg :up) [(move l -1) nil]
+    (= msg :down) [(move l 1) nil]
+    (= msg :enter) [l (select-event l)]
+    (or (= msg "q") (= msg :esc)) [l {:type :cancel}]
+    :else (if-let [action (action-for-key l msg)]
+            [l (action-event l action)]
+            [l nil])))
+
+(defn bindings
+  "Help-line entries (see tiny-tui.help/view) for this list's keys:
+   navigation, enter, one per action, quit."
+  [l]
+  (vec (concat [{:key "↑/↓" :label "navigate"}
+                {:key "enter" :label "select"}]
+               (map (fn [a] {:key (:key a) :label (:label a)}) (:actions l))
+               [{:key "q" :label "quit"}])))
+
+(defn view [l]
+  (if (empty? (:items l))
+    (:empty-text l)
+    (string/join "\n"
+                 (map-indexed
+                   (fn [i item]
+                     (let [text ((:item->text l) item)]
+                       (if (= i (:cursor l))
+                         (str "› " (style/inverse text))
+                         (str "  " text))))
+                   (:items l)))))
diff --git a/test/tiny_tui/core_test.lg b/test/tiny_tui/core_test.lg
index dbd5ae8..1b607c8 100644
--- a/test/tiny_tui/core_test.lg
+++ b/test/tiny_tui/core_test.lg
@@ -1,81 +1,165 @@
 (ns tiny-tui.core-test
   (:require [clojure.test :refer :all]
-            [tiny-tui.core :as tui]))
+            [tiny-tui.core :as tui]
+            [tiny-tui.help :as help]
+            [tiny-tui.layout :as layout]
+            [tiny-tui.list :as tlist]
+            [tiny-tui.style :as style]))
 
 (defn scripted
   "Read-fn that returns the scripted messages one by one, then nil (EOF)."
   [msgs]
   (let [q (atom (seq msgs))]
     (fn []
       (let [m (first @q)]
         (swap! q rest)
         m))))
 
 (defn counter-app [frames]
   {:init {:count 0}
    :update (fn [state msg]
              (case msg
                :up [(update state :count inc) nil]
                :down [(update state :count dec) nil]
                "q" [state :quit]
                [state nil]))
    :view (fn [state] (str "Count: " (:count state)))
    :render-fn (fn [s] (swap! frames conj s))
    :screen false})
 
 (deftest test-run-counter
   (let [frames (atom [])
         [state event] (tui/run (assoc (counter-app frames)
                                       :read-key-fn (scripted [:up :up :down "q"])))]
     (is (= 1 (:count state)))
     (is (= :quit event))
     ;; one frame per loop iteration: initial + after each of the 3 moves
     (is (= 4 (count @frames)))
     (is (= "Count: 1" (last @frames)))))
 
 (deftest test-run-ctrl-c-quits-without-update
   (let [seen (atom [])
         app {:init {}
              :update (fn [state msg] (swap! seen conj msg) [state nil])
              :view (fn [_] "x")
              :render-fn (fn [_] nil)
              :screen false
              :read-key-fn (scripted [:ctrl-c])}
         [_ event] (tui/run app)]
     (is (= :ctrl-c event))
     (is (= [] @seen))))
 
 (deftest test-run-resize-rerenders-without-update
   (let [seen (atom [])
         frames (atom [])
         app {:init {}
              :update (fn [state msg] (swap! seen conj msg) [state :quit])
              :view (fn [_] "x")
              :render-fn (fn [s] (swap! frames conj s))
              :screen false
              :read-key-fn (scripted [:resize "q"])}]
     (tui/run app)
     (is (= ["q"] @seen))
     (is (= 2 (count @frames)))))
 
 (deftest test-run-injects-tui-size
   (let [sizes (atom [])
         app {:init {}
              :update (fn [state _] [state :quit])
              :view (fn [state] (swap! sizes conj (:tui/size state)) "x")
              :render-fn (fn [_] nil)
              :screen false
              :read-key-fn (scripted ["q"])}]
     (tui/run app)
     (is (= [[80 24]] @sizes))))
 
+(def projects
+  [{:name "tiny-cli"} {:name "tiny-tui"} {:name "lgx"}])
+
+(defn select-opts [script frames]
+  {:title "Choose project"
+   :items projects
+   :item->text :name
+   :read-key-fn (scripted script)
+   :render-fn (fn [s] (swap! frames conj s))
+   :screen false})
+
+(deftest test-select-picks-item
+  (is (= {:type :select
+          :item {:name "tiny-tui"}
+          :index 1}
+         (tui/select (select-opts [:down :enter] (atom []))))))
+
+(deftest test-select-cancel
+  (is (= {:type :cancel} (tui/select (select-opts ["q"] (atom [])))))
+  (is (= {:type :cancel} (tui/select (select-opts [:esc] (atom [])))))
+  (is (= {:type :cancel} (tui/select (select-opts [:ctrl-c] (atom [])))))
+  ;; EOF also cancels
+  (is (= {:type :cancel} (tui/select (select-opts [] (atom []))))))
+
+(deftest test-select-frame
+  (let [frames (atom [])]
+    (tui/select (select-opts ["q"] frames))
+    (is (= (layout/vstack
+             (style/bold "Choose project")
+             ""
+             (tlist/view (tlist/create {:items projects
+                                        :item->text :name}))
+             ""
+             (help/view [{:key "↑/↓"
+                          :label "navigate"}
+                         {:key "enter"
+                          :label "select"}
+                         {:key "q"
+                          :label "quit"}]))
+           (first @frames)))))
+
+(deftest test-select-without-title
+  (let [frames (atom [])]
+    (tui/select (assoc (select-opts ["q"] frames) :title nil))
+    (is (= (layout/vstack
+             (tlist/view (tlist/create {:items projects
+                                        :item->text :name}))
+             ""
+             (help/view [{:key "↑/↓"
+                          :label "navigate"}
+                         {:key "enter"
+                          :label "select"}
+                         {:key "q"
+                          :label "quit"}]))
+           (first @frames)))))
+
+(def delete-action
+  {:id :delete :key "d" :label "delete" :destructive? true})
+
+(deftest test-select-action-event
+  (is (= {:type :action
+          :action :delete
+          :item {:name "tiny-cli"}
+          :index 0
+          :destructive? true}
+         (tui/select (assoc (select-opts ["d"] (atom []))
+                            :actions [delete-action])))))
+
+(deftest test-select-frame-includes-action-help
+  (let [frames (atom [])
+        opts {:items projects :item->text :name :actions [delete-action]}]
+    (tui/select (merge (select-opts ["q"] frames) opts))
+    (is (= (layout/vstack
+            (style/bold "Choose project")
+            ""
+            (tlist/view (tlist/create opts))
+            ""
+            (help/view (tlist/bindings (tlist/create opts))))
+           (first @frames)))))
+
 (deftest test-run-eof-terminates
   (let [app {:init {:a 1}
              :update (fn [state _] [state nil])
              :view (fn [_] "x")
              :render-fn (fn [_] nil)
              :screen false
              :read-key-fn (scripted [])}
         [state event] (tui/run app)]
     (is (= 1 (:a state)))
     (is (nil? event))))
diff --git a/test/tiny_tui/list_test.lg b/test/tiny_tui/list_test.lg
new file mode 100644
index 0000000..59fc890
--- /dev/null
+++ b/test/tiny_tui/list_test.lg
@@ -0,0 +1,129 @@
+(ns tiny-tui.list-test
+  (:require [clojure.test :refer :all]
+            [string]
+            [tiny-tui.list :as tlist]
+            [tiny-tui.style :as style]))
+
+(def projects
+  [{:name "tiny-cli"} {:name "tiny-tui"} {:name "lgx"}])
+
+(defn make []
+  (tlist/create {:items projects
+                 :item->text :name}))
+
+(deftest test-create
+  (let [l (make)]
+    (is (= 0 (tlist/selected-index l)))
+    (is (= {:name "tiny-cli"} (tlist/selected-item l)))))
+
+(deftest test-cursor-moves-and-clamps
+  (let [l (make)
+        down (fn [l] (first (tlist/update l :down)))
+        up (fn [l] (first (tlist/update l :up)))]
+    (is (= 1 (tlist/selected-index (down l))))
+    (is (= {:name "tiny-tui"} (tlist/selected-item (down l))))
+    ;; clamped at the bottom
+    (is (= 2 (tlist/selected-index (down (down (down (down l)))))))
+    ;; clamped at the top
+    (is (= 0 (tlist/selected-index (up l))))
+    ;; moving returns no event
+    (is (= nil (second (tlist/update l :down))))))
+
+(deftest test-enter-selects
+  (let [[l' event] (tlist/update (first (tlist/update (make) :down)) :enter)]
+    (is (= {:type :select
+            :item {:name "tiny-tui"}
+            :index 1} event))
+    (is (= 1 (tlist/selected-index l')))))
+
+(deftest test-quit-and-esc-cancel
+  (is (= {:type :cancel} (second (tlist/update (make) "q"))))
+  (is (= {:type :cancel} (second (tlist/update (make) :esc)))))
+
+(deftest test-unknown-message-ignored
+  (let [l (make)
+        [l' event] (tlist/update l "z")]
+    (is (= l l'))
+    (is (nil? event))))
+
+(deftest test-view
+  (is (= (string/join "\n"
+                      [(str "› " (style/inverse "tiny-cli"))
+                       "  tiny-tui"
+                       "  lgx"])
+         (tlist/view (make))))
+  (is (= (string/join "\n"
+                      ["  tiny-cli"
+                       (str "› " (style/inverse "tiny-tui"))
+                       "  lgx"])
+         (tlist/view (first (tlist/update (make) :down))))))
+
+(deftest test-item->text-defaults-to-str
+  (let [l (tlist/create {:items ["a" "b"]})]
+    (is (= (string/join "\n" [(str "› " (style/inverse "a")) "  b"])
+           (tlist/view l)))))
+
+(deftest test-falsey-items-are-selectable
+  (let [l (tlist/create {:items [false nil true]})]
+    (is (= {:type :select
+            :item false
+            :index 0}
+           (second (tlist/update l :enter))))
+    (is (= {:type :select
+            :item nil
+            :index 1}
+           (second (tlist/update (first (tlist/update l :down)) :enter))))))
+
+(def actions
+  [{:id :open :key "o" :label "open"}
+   {:id :delete :key "d" :label "delete" :destructive? true}])
+
+(defn make-with-actions []
+  (tlist/create {:items projects :item->text :name :actions actions}))
+
+(deftest test-action-key-returns-action-event
+  (let [l (first (tlist/update (make-with-actions) :down))]
+    (is (= {:type :action
+            :action :delete
+            :item {:name "tiny-tui"}
+            :index 1
+            :destructive? true}
+           (second (tlist/update l "d"))))))
+
+(deftest test-non-destructive-action
+  (is (= {:type :action
+          :action :open
+          :item {:name "tiny-cli"}
+          :index 0}
+         (second (tlist/update (make-with-actions) "o")))))
+
+(deftest test-action-on-empty-list-ignored
+  (let [l (tlist/create {:items [] :actions actions})]
+    (is (nil? (second (tlist/update l "d"))))))
+
+(deftest test-quit-still-cancels-with-actions
+  (is (= {:type :cancel}
+         (second (tlist/update (make-with-actions) "q")))))
+
+(deftest test-bindings
+  (is (= [{:key "↑/↓" :label "navigate"}
+          {:key "enter" :label "select"}
+          {:key "o" :label "open"}
+          {:key "d" :label "delete"}
+          {:key "q" :label "quit"}]
+         (tlist/bindings (make-with-actions))))
+  (is (= [{:key "↑/↓" :label "navigate"}
+          {:key "enter" :label "select"}
+          {:key "q" :label "quit"}]
+         (tlist/bindings (make)))))
+
+(deftest test-empty-list
+  (let [l (tlist/create {:items []})]
+    (is (= "No items." (tlist/view l)))
+    (is (nil? (tlist/selected-item l)))
+    (is (nil? (tlist/selected-index l)))
+    (is (nil? (second (tlist/update l :enter))))
+    (is (= l (first (tlist/update l :down)))))
+  (let [l (tlist/create {:items []
+                         :empty-text "Nothing here"})]
+    (is (= "Nothing here" (tlist/view l)))))

