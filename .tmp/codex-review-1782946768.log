++        app {:init {}
++             :update (fn [state msg] (swap! seen conj msg) [state nil])
++             :view (fn [_] "x")
++             :render-fn (fn [_] nil)
++             :screen false
++             :read-key-fn (scripted [:ctrl-c])}
++        [_ event] (tui/run app)]
++    (is (= :ctrl-c event))
++    (is (= [] @seen))))
++
++(deftest test-run-resize-rerenders-without-update
++  (let [seen (atom [])
++        frames (atom [])
++        app {:init {}
++             :update (fn [state msg] (swap! seen conj msg) [state :quit])
++             :view (fn [_] "x")
++             :render-fn (fn [s] (swap! frames conj s))
++             :screen false
++             :read-key-fn (scripted [:resize "q"])}]
++    (tui/run app)
++    (is (= ["q"] @seen))
++    (is (= 2 (count @frames)))))
++
++(deftest test-run-injects-tui-size
++  (let [sizes (atom [])
++        app {:init {}
++             :update (fn [state _] [state :quit])
++             :view (fn [state] (swap! sizes conj (:tui/size state)) "x")
++             :render-fn (fn [_] nil)
++             :screen false
++             :read-key-fn (scripted ["q"])}]
++    (tui/run app)
++    (is (= [[80 24]] @sizes))))
++
++(deftest test-run-eof-terminates
++  (let [app {:init {:a 1}
++             :update (fn [state _] [state nil])
++             :view (fn [_] "x")
++             :render-fn (fn [_] nil)
++             :screen false
++             :read-key-fn (scripted [])}
++        [state event] (tui/run app)]
++    (is (= 1 (:a state)))
++    (is (nil? event))))
