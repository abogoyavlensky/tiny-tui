+diff --git a/src/tiny_tui/style.lg b/src/tiny_tui/style.lg
+new file mode 100644
+index 0000000..2c289a4
+--- /dev/null
++++ b/src/tiny_tui/style.lg
+@@ -0,0 +1,83 @@
++;; tiny-tui.style — pure ANSI text styling. Every function takes text and
++;; returns text wrapped in SGR escape sequences; nothing here touches the
++;; terminal (term/set-fg etc. write directly to stdout, which is the wrong
++;; shape for string-based views).
++;;
++;; Named colors use the portable 16-color codes; an integer color is passed
++;; through as 256-color. Escape bytes are built with (char 27), never
++;; written literally in source.
++
++(ns tiny-tui.style
++  (:require [string]))
++
++(def ^:private ESC (str (char 27)))
++(def ^:private esc-char (char 27))
++(def ^:private reset (str ESC "[0m"))
++
++(def ^:private color-codes
++  {:black 30
++   :red 31
++   :green 32
++   :yellow 33
++   :blue 34
++   :magenta 35
++   :cyan 36
++   :white 37
++   :bright-black 90
++   :bright-red 91
++   :bright-green 92
++   :bright-yellow 93
++   :bright-blue 94
++   :bright-magenta 95
++   :bright-cyan 96
++   :bright-white 97})
++
++(defn- fg-code [c]
++  (if (keyword? c)
++    (str (get color-codes c))
++    (str "38;5;" c)))
++
++(defn- bg-code [c]
++  (if (keyword? c)
++    (str (+ 10 (get color-codes c)))
++    (str "48;5;" c)))
++
++(defn- sgr [codes s]
++  (if (empty? codes)
++    s
++    (str ESC "[" (string/join ";" codes) "m" s reset)))
++
++(defn bold [s] (sgr ["1"] s))
++(defn dim [s] (sgr ["2"] s))
++(defn inverse [s] (sgr ["7"] s))
++(defn fg [c s] (sgr [(fg-code c)] s))
++(defn bg [c s] (sgr [(bg-code c)] s))
++
++(defn styled
++  "Apply several attributes at once as a single SGR sequence.
++   attrs: {:bold? :dim? :inverse? :fg :bg}"
++  [attrs s]
++  (sgr (remove nil?
++               [(when (:bold? attrs) "1")
++                (when (:dim? attrs) "2")
++                (when (:inverse? attrs) "7")
++                (when-let [c (:fg attrs)] (fg-code c))
++                (when-let [c (:bg attrs)] (bg-code c))])
++       s))
++
++(defn strip
++  "Remove all ESC[...m sequences, leaving the visible text."
++  [s]
++  (loop [cs (seq s) out []]
++    (if (empty? cs)
++      (apply str out)
++      (let [c (first cs)]
++        (if (= c esc-char)
++          (recur (rest (drop-while #(not= % \m) cs)) out)
++          (recur (rest cs) (conj out c)))))))
++
++(defn visible-width
++  "Display width of `s` ignoring escape sequences. Counts characters —
++   wide-rune handling is out of scope for V1."
++  [s]
++  (count (strip s)))
+diff --git a/test/tiny_tui/core_test.lg b/test/tiny_tui/core_test.lg
+index 37dc0ac..dbd5ae8 100644
+--- a/test/tiny_tui/core_test.lg
++++ b/test/tiny_tui/core_test.lg
+@@ -1,6 +1,81 @@
+-(ns tiny-tui.greeter-test
++(ns tiny-tui.core-test
+   (:require [clojure.test :refer :all]
+-            [tiny-tui.core :as c]))
++            [tiny-tui.core :as tui]))
+ 
+-(deftest test-greet-ok
+-  (is (= "Welcome to let-go!" (c/greet "let-go"))))
++(defn scripted
++  "Read-fn that returns the scripted messages one by one, then nil (EOF)."
++  [msgs]
++  (let [q (atom (seq msgs))]
++    (fn []
++      (let [m (first @q)]
++        (swap! q rest)
++        m))))
++
++(defn counter-app [frames]
++  {:init {:count 0}
++   :update (fn [state msg]
++             (case msg
++               :up [(update state :count inc) nil]
++               :down [(update state :count dec) nil]
++               "q" [state :quit]
++               [state nil]))
++   :view (fn [state] (str "Count: " (:count state)))
++   :render-fn (fn [s] (swap! frames conj s))
++   :screen false})
++
++(deftest test-run-counter
++  (let [frames (atom [])
++        [state event] (tui/run (assoc (counter-app frames)
++                                      :read-key-fn (scripted [:up :up :down "q"])))]
++    (is (= 1 (:count state)))
++    (is (= :quit event))
++    ;; one frame per loop iteration: initial + after each of the 3 moves
++    (is (= 4 (count @frames)))
++    (is (= "Count: 1" (last @frames)))))
++
++(deftest test-run-ctrl-c-quits-without-update
++  (let [seen (atom [])
++        app {:init {}
++             :update (fn [state msg] (swap! seen conj msg) [state nil])
++             :view (fn [_] "x")
++             :render-fn (fn [_] nil)
++             :screen false
++             :read-key-fn (scripted [:ctrl-c])}
++        [_ event] (tui/run app)]
++    (is (= :ctrl-c event))
++    (is (= [] @seen))))
++
++(deftest test-run-resize-rerenders-without-update
++  (let [seen (atom [])
++        frames (atom [])
++        app {:init {}
++             :update (fn [state msg] (swap! seen conj msg) [state :quit])
++             :view (fn [_] "x")
++             :render-fn (fn [s] (swap! frames conj s))
++             :screen false
++             :read-key-fn (scripted [:resize "q"])}]
++    (tui/run app)
++    (is (= ["q"] @seen))
++    (is (= 2 (count @frames)))))
++
++(deftest test-run-injects-tui-size
++  (let [sizes (atom [])
++        app {:init {}
++             :update (fn [state _] [state :quit])
++             :view (fn [state] (swap! sizes conj (:tui/size state)) "x")
++             :render-fn (fn [_] nil)
++             :screen false
++             :read-key-fn (scripted ["q"])}]
++    (tui/run app)
++    (is (= [[80 24]] @sizes))))
++
++(deftest test-run-eof-terminates
++  (let [app {:init {:a 1}
++             :update (fn [state _] [state nil])
++             :view (fn [_] "x")
++             :render-fn (fn [_] nil)
