    41	  [l msg]
    42	  (cond
    43	    (= msg :up) [(move l -1) nil]
    44	    (= msg :down) [(move l 1) nil]
    45	    (= msg :enter) [l (select-event l)]
    46	    (or (= msg "q") (= msg :esc)) [l {:type :cancel}]
    47	    :else [l nil]))
    48	
    49	(defn view [l]
    50	  (if (empty? (:items l))
    51	    (:empty-text l)
    52	    (string/join "\n"
    53	                 (map-indexed
    54	                   (fn [i item]
    55	                     (let [text ((:item->text l) item)]
    56	                       (if (= i (:cursor l))
    57	                         (str "› " (style/inverse text))
    58	                         (str "  " text))))
    59	                   (:items l)))))
     1	;; tiny-tui.core — the public API.
     2	;;
     3	;; run: the minimal program loop. An app is three things:
     4	;;   :init   initial state (a map)
     5	;;   :update (fn [state msg] [new-state event]) — nil event keeps looping,
     6	;;           any non-nil event stops the loop
     7	;;   :view   (fn [state] string)
     8	;;
     9	;; run returns [final-state event]. It handles :ctrl-c itself (returns
    10	;; event :ctrl-c without consulting :update) and treats :resize as a plain
    11	;; redraw. Terminal size is injected as :tui/size before every view call.
    12	;;
    13	;; Testing hooks (all optional): :read-key-fn, :render-fn, :screen false —
    14	;; they let whole flows run headlessly with scripted keys.
    15	
    16	(ns tiny-tui.core
    17	  (:require [term]
    18	            [tiny-tui.help :as help]
    19	            [tiny-tui.key :as key]
    20	            [tiny-tui.layout :as layout]
    21	            [tiny-tui.list :as tlist]
    22	            [tiny-tui.screen :as screen]
    23	            [tiny-tui.style :as style]))
    24	
    25	(defn- run-loop [opts]
    26	  (let [update-fn (:update opts)
    27	        view (:view opts)
    28	        read-key-fn (or (:read-key-fn opts) key/read)
    29	        render-fn (or (:render-fn opts) screen/render!)]
    30	    (loop [state (:init opts)]
    31	      (let [state (assoc state :tui/size (or (term/size) [80 24]))]
    32	        (render-fn (view state))
    33	        (let [msg (read-key-fn)]
    34	          (cond
    35	            (nil? msg) [state nil]
    36	            (= msg :ctrl-c) [state :ctrl-c]
    37	            (= msg :resize) (recur state)
    38	            :else (let [result (update-fn state msg)
    39	                        next-state (first result)
    40	                        event (second result)]
    41	                    (if (nil? event)
    42	                      (recur next-state)
    43	                      [next-state event]))))))))
    44	
    45	(defn run
    46	  "Run a TUI program (see namespace docstring). Returns [final-state event]."
    47	  [opts]
    48	  (if (false? (:screen opts))
    49	    (run-loop opts)
    50	    (screen/with-screen
    51	      (run-loop opts))))
    52	
    53	(def ^:private select-bindings
    54	  [{:key "↑/↓"
    55	    :label "navigate"}
    56	   {:key "enter"
    57	    :label "select"}
    58	   {:key "q"
    59	    :label "quit"}])
    60	
    61	(defn- select-view [opts list-state]
    62	  (apply layout/vstack
    63	         (concat
    64	           (when (:title opts)
    65	             [(style/bold (:title opts)) ""])
    66	           [(tlist/view list-state)
    67	            ""
    68	            (help/view select-bindings)])))
    69	
    70	(defn select
    71	  "Show a navigable list and return the user's choice:
    72	     {:type :select :item item :index n}  on enter
    73	     {:type :cancel}                      on q / esc / Ctrl-C
    74	   opts: :title, :items, :item->text (see tiny-tui.list/create), plus the
    75	   run testing hooks (:read-key-fn :render-fn :screen)."
    76	  [opts]
    77	  (let [result (run {:init {:list (tlist/create opts)}
    78	                     :update (fn [state msg]
    79	                               (let [r (tlist/update (:list state) msg)]
    80	                                 [(assoc state :list (first r)) (second r)]))
    81	                     :view (fn [state] (select-view opts (:list state)))
    82	                     :read-key-fn (:read-key-fn opts)
    83	                     :render-fn (:render-fn opts)
    84	                     :screen (:screen opts)})
    85	        event (second result)]
    86	    (if (map? event)
    87	      event
    88	      {:type :cancel})))
