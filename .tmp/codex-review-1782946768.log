+-(defn greet
+-  [name]
+-  (str "Welcome to " name "!"))
++(ns tiny-tui.core
++  (:require [term]
++            [tiny-tui.help :as help]
++            [tiny-tui.key :as key]
++            [tiny-tui.layout :as layout]
++            [tiny-tui.list :as tlist]
++            [tiny-tui.screen :as screen]
++            [tiny-tui.style :as style]))
++
++(defn- run-loop [opts]
++  (let [update-fn (:update opts)
++        view (:view opts)
++        read-key-fn (or (:read-key-fn opts) key/read)
++        render-fn (or (:render-fn opts) screen/render!)]
++    (loop [state (:init opts)]
++      (let [state (assoc state :tui/size (or (term/size) [80 24]))]
++        (render-fn (view state))
++        (let [msg (read-key-fn)]
++          (cond
++            (nil? msg) [state nil]
++            (= msg :ctrl-c) [state :ctrl-c]
++            (= msg :resize) (recur state)
++            :else (let [result (update-fn state msg)
++                        next-state (first result)
++                        event (second result)]
++                    (if (nil? event)
++                      (recur next-state)
++                      [next-state event]))))))))
++
++(defn run
++  "Run a TUI program (see namespace docstring). Returns [final-state event]."
++  [opts]
++  (if (false? (:screen opts))
++    (run-loop opts)
++    (screen/with-screen
++      (run-loop opts))))
++
++(def ^:private select-bindings
++  [{:key "↑/↓" :label "navigate"}
++   {:key "enter" :label "select"}
++   {:key "q" :label "quit"}])
++
++(defn- select-view [opts list-state]
++  (apply layout/vstack
++         (concat
++          (when (:title opts)
++            [(style/bold (:title opts)) ""])
++          [(tlist/view list-state)
++           ""
++           (help/view select-bindings)])))
++
++(defn select
++  "Show a navigable list and return the user's choice:
++     {:type :select :item item :index n}  on enter
++     {:type :cancel}                      on q / esc / Ctrl-C
++   opts: :title, :items, :item->text (see tiny-tui.list/create), plus the
++   run testing hooks (:read-key-fn :render-fn :screen)."
++  [opts]
++  (let [result (run {:init {:list (tlist/create opts)}
++                     :update (fn [state msg]
++                               (let [r (tlist/update (:list state) msg)]
++                                 [(assoc state :list (first r)) (second r)]))
++                     :view (fn [state] (select-view opts (:list state)))
++                     :read-key-fn (:read-key-fn opts)
++                     :render-fn (:render-fn opts)
++                     :screen (:screen opts)})
++        event (second result)]
++    (if (map? event)
++      event
++      {:type :cancel})))
