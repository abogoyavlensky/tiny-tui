 (ns tiny-tui.key-test
   (:require [clojure.test :refer :all]
             [tiny-tui.key :as key]))
 
 (def ESC (str (char 27)))
 
 (deftest test-parse-arrows
   (is (= :up (key/parse (str ESC "[A"))))
   (is (= :up (key/parse (str ESC "OA"))))
   (is (= :down (key/parse (str ESC "[B"))))
   (is (= :down (key/parse (str ESC "OB"))))
   (is (= :right (key/parse (str ESC "[C"))))
   (is (= :left (key/parse (str ESC "[D")))))
 
 (deftest test-parse-nav-keys
   (is (= :home (key/parse (str ESC "[H"))))
   (is (= :home (key/parse (str ESC "[1~"))))
   (is (= :end (key/parse (str ESC "[F"))))
   (is (= :end (key/parse (str ESC "[4~"))))
   (is (= :delete (key/parse (str ESC "[3~")))))
 
 (deftest test-parse-named-keys
   (is (= :enter (key/parse (str (char 13)))))
+  (is (= :enter (key/parse (str (char 10)))))
   (is (= :tab (key/parse (str (char 9)))))
   (is (= :backspace (key/parse (str (char 127)))))
   (is (= :esc (key/parse ESC))))
 
 (deftest test-parse-control-keys
   (is (= :ctrl-c (key/parse (str (char 3)))))
   (is (= :ctrl-a (key/parse (str (char 1)))))
   (is (= :ctrl-space (key/parse (str (char 0)))))
   ;; BEL doubles as term/read-key's resize wake-up
   (is (= :resize (key/parse (str (char 7))))))
 
 (deftest test-parse-printables-pass-through
   (is (= "q" (key/parse "q")))
   (is (= "d" (key/parse "d")))
   (is (= " " (key/parse " "))))
diff --git a/test/tiny_tui/list_test.lg b/test/tiny_tui/list_test.lg
new file mode 100644
index 0000000..59fc890
--- /dev/null
+++ b/test/tiny_tui/list_test.lg
@@ -0,0 +1,129 @@
+(ns tiny-tui.list-test
+  (:require [clojure.test :refer :all]
+            [string]
+            [tiny-tui.list :as tlist]
+            [tiny-tui.style :as style]))
+
+(def projects
+  [{:name "tiny-cli"} {:name "tiny-tui"} {:name "lgx"}])
+
+(defn make []
+  (tlist/create {:items projects
+                 :item->text :name}))
+
+(deftest test-create
+  (let [l (make)]
+    (is (= 0 (tlist/selected-index l)))
+    (is (= {:name "tiny-cli"} (tlist/selected-item l)))))
+
+(deftest test-cursor-moves-and-clamps
+  (let [l (make)
+        down (fn [l] (first (tlist/update l :down)))
+        up (fn [l] (first (tlist/update l :up)))]
+    (is (= 1 (tlist/selected-index (down l))))
+    (is (= {:name "tiny-tui"} (tlist/selected-item (down l))))
+    ;; clamped at the bottom
+    (is (= 2 (tlist/selected-index (down (down (down (down l)))))))
+    ;; clamped at the top
+    (is (= 0 (tlist/selected-index (up l))))
+    ;; moving returns no event
+    (is (= nil (second (tlist/update l :down))))))
+
+(deftest test-enter-selects
+  (let [[l' event] (tlist/update (first (tlist/update (make) :down)) :enter)]
+    (is (= {:type :select
+            :item {:name "tiny-tui"}
+            :index 1} event))
+    (is (= 1 (tlist/selected-index l')))))
+
+(deftest test-quit-and-esc-cancel
+  (is (= {:type :cancel} (second (tlist/update (make) "q"))))
+  (is (= {:type :cancel} (second (tlist/update (make) :esc)))))
+
+(deftest test-unknown-message-ignored
+  (let [l (make)
+        [l' event] (tlist/update l "z")]
+    (is (= l l'))
+    (is (nil? event))))
+
+(deftest test-view
+  (is (= (string/join "\n"
+                      [(str "› " (style/inverse "tiny-cli"))
+                       "  tiny-tui"
+                       "  lgx"])
+         (tlist/view (make))))
+  (is (= (string/join "\n"
+                      ["  tiny-cli"
+                       (str "› " (style/inverse "tiny-tui"))
+                       "  lgx"])
+         (tlist/view (first (tlist/update (make) :down))))))
+
+(deftest test-item->text-defaults-to-str
+  (let [l (tlist/create {:items ["a" "b"]})]
+    (is (= (string/join "\n" [(str "› " (style/inverse "a")) "  b"])
+           (tlist/view l)))))
+
+(deftest test-falsey-items-are-selectable
+  (let [l (tlist/create {:items [false nil true]})]
+    (is (= {:type :select
+            :item false
+            :index 0}
+           (second (tlist/update l :enter))))
+    (is (= {:type :select
+            :item nil
+            :index 1}
+           (second (tlist/update (first (tlist/update l :down)) :enter))))))
+
+(def actions
+  [{:id :open :key "o" :label "open"}
+   {:id :delete :key "d" :label "delete" :destructive? true}])
+
+(defn make-with-actions []
+  (tlist/create {:items projects :item->text :name :actions actions}))
+
+(deftest test-action-key-returns-action-event
+  (let [l (first (tlist/update (make-with-actions) :down))]
+    (is (= {:type :action
+            :action :delete
+            :item {:name "tiny-tui"}
+            :index 1
+            :destructive? true}
+           (second (tlist/update l "d"))))))
+
+(deftest test-non-destructive-action
+  (is (= {:type :action
+          :action :open
+          :item {:name "tiny-cli"}
+          :index 0}
+         (second (tlist/update (make-with-actions) "o")))))
+
+(deftest test-action-on-empty-list-ignored
+  (let [l (tlist/create {:items [] :actions actions})]
+    (is (nil? (second (tlist/update l "d"))))))
+
+(deftest test-quit-still-cancels-with-actions
+  (is (= {:type :cancel}
+         (second (tlist/update (make-with-actions) "q")))))
+
+(deftest test-bindings
+  (is (= [{:key "↑/↓" :label "navigate"}
+          {:key "enter" :label "select"}
+          {:key "o" :label "open"}
+          {:key "d" :label "delete"}
+          {:key "q" :label "quit"}]
+         (tlist/bindings (make-with-actions))))
+  (is (= [{:key "↑/↓" :label "navigate"}
+          {:key "enter" :label "select"}
+          {:key "q" :label "quit"}]
+         (tlist/bindings (make)))))
+
+(deftest test-empty-list
+  (let [l (tlist/create {:items []})]
+    (is (= "No items." (tlist/view l)))
+    (is (nil? (tlist/selected-item l)))
+    (is (nil? (tlist/selected-index l)))
+    (is (nil? (second (tlist/update l :enter))))
+    (is (= l (first (tlist/update l :down)))))
+  (let [l (tlist/create {:items []
+                         :empty-text "Nothing here"})]
+    (is (= "Nothing here" (tlist/view l)))))

