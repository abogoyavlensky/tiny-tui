 ;; tiny-tui.core — the public API.
 ;;
 ;; run: the minimal program loop. An app is three things:
 ;;   :init   initial state (a map)
 ;;   :update (fn [state msg] [new-state event]) — nil event keeps looping,
 ;;           any non-nil event stops the loop
 ;;   :view   (fn [state] string)
 ;;
 ;; run returns [final-state event]. It handles :ctrl-c itself (returns
 ;; event :ctrl-c without consulting :update) and treats :resize as a plain
 ;; redraw. Terminal size is injected as :tui/size before every view call.
 ;;
 ;; Testing hooks (all optional): :read-key-fn, :render-fn, :screen false —
 ;; they let whole flows run headlessly with scripted keys.
 
 (ns tiny-tui.core
   (:require [term]
+            [tiny-tui.help :as help]
             [tiny-tui.key :as key]
-            [tiny-tui.screen :as screen]))
+            [tiny-tui.layout :as layout]
+            [tiny-tui.list :as tlist]
+            [tiny-tui.screen :as screen]
+            [tiny-tui.style :as style]))
 
 (defn- run-loop [opts]
   (let [update-fn (:update opts)
         view (:view opts)
         read-key-fn (or (:read-key-fn opts) key/read)
         render-fn (or (:render-fn opts) screen/render!)]
     (loop [state (:init opts)]
       (let [state (assoc state :tui/size (or (term/size) [80 24]))]
         (render-fn (view state))
         (let [msg (read-key-fn)]
           (cond
             (nil? msg) [state nil]
             (= msg :ctrl-c) [state :ctrl-c]
             (= msg :resize) (recur state)
             :else (let [result (update-fn state msg)
                         next-state (first result)
                         event (second result)]
                     (if (nil? event)
                       (recur next-state)
                       [next-state event]))))))))
 
 (defn run
   "Run a TUI program (see namespace docstring). Returns [final-state event]."
   [opts]
   (if (false? (:screen opts))
     (run-loop opts)
     (screen/with-screen
       (run-loop opts))))
+
+(def ^:private select-bindings
+  [{:key "↑/↓"
+    :label "navigate"}
+   {:key "enter"
+    :label "select"}
+   {:key "q"
+    :label "quit"}])
+
+(defn- select-view [opts list-state]
+  (apply layout/vstack
+         (concat
+           (when (:title opts)
+             [(style/bold (:title opts)) ""])
+           [(tlist/view list-state)
+            ""
+            (help/view select-bindings)])))
+
+(defn select
+  "Show a navigable list and return the user's choice:
+     {:type :select :item item :index n}  on enter
+     {:type :cancel}                      on q / esc / Ctrl-C
+   opts: :title, :items, :item->text (see tiny-tui.list/create), plus the
+   run testing hooks (:read-key-fn :render-fn :screen)."
+  [opts]
+  (let [result (run {:init {:list (tlist/create opts)}
+                     :update (fn [state msg]
+                               (let [r (tlist/update (:list state) msg)]
+                                 [(assoc state :list (first r)) (second r)]))
+                     :view (fn [state] (select-view opts (:list state)))
+                     :read-key-fn (:read-key-fn opts)
+                     :render-fn (:render-fn opts)
+                     :screen (:screen opts)})
+        event (second result)]
+    (if (map? event)
+      event
+      {:type :cancel})))
diff --git a/src/tiny_tui/key.lg b/src/tiny_tui/key.lg
index ae76f76..7aca1eb 100644
--- a/src/tiny_tui/key.lg
+++ b/src/tiny_tui/key.lg
@@ -1,53 +1,56 @@
 ;; tiny-tui.key — translate raw terminal input into simple messages:
 ;; keywords for special keys (:up :down :enter :esc :ctrl-c ...), plain
 ;; one-character strings for printable text.
 ;;
 ;; Only `read` touches the terminal; `parse` is pure and unit-tested.
 ;; Control bytes are built with (char code) rather than written literally
 ;; in source (mirrors legmacs.keys).
 
 (ns tiny-tui.key
   (:require [term]))
 
 (def ^:private ESC (str (char 27)))
 
 (def ^:private special
   (into {}
         (concat
           (map (fn [pair] [(str ESC (first pair)) (second pair)])
                [["[A" :up] ["OA" :up]
                 ["[B" :down] ["OB" :down]
                 ["[C" :right] ["OC" :right]
                 ["[D" :left] ["OD" :left]
                 ["[H" :home] ["OH" :home] ["[1~" :home] ["[7~" :home]
                 ["[F" :end] ["OF" :end] ["[4~" :end] ["[8~" :end]
                 ["[3~" :delete]
                 ["[5~" :pageup]
                 ["[6~" :pagedown]])
+          ;; Enter arrives as CR in raw mode; LF shows up when input passed
+          ;; through a cooked-mode tty (ICRNL) or a plain pipe. Map both.
           [[(str (char 13)) :enter]
+           [(str (char 10)) :enter]
            [(str (char 9)) :tab]
            [(str (char 127)) :backspace]
            [ESC :esc]
            [(str (char 0)) :ctrl-space]
           ;; BEL is term/read-key's synthetic resize wake-up, and also a
           ;; genuine Ctrl-G — indistinguishable by design. Treating both as
           ;; :resize is harmless: the loop just redraws.
            [(str (char 7)) :resize]])))
 
 (defn- ctrl-key [code]
   (keyword (str "ctrl-" (char (+ code 96)))))
 
 (defn parse
   "Translate one term/read-key token into a message. Printable text passes
    through unchanged."
   [k]
   (let [code (when (= 1 (count k)) (int (first (seq k))))]
     (cond
       (contains? special k) (get special k)
       (and code (<= 1 code 26)) (ctrl-key code)
       :else k)))
 
 (defn read
   "Block for one key. Returns a message, or nil at end of input."
   []
   (some-> (term/read-key) parse))
diff --git a/src/tiny_tui/list.lg b/src/tiny_tui/list.lg
new file mode 100644
index 0000000..176f62f
--- /dev/null
+++ b/src/tiny_tui/list.lg
@@ -0,0 +1,59 @@
+;; tiny-tui.list — a pure list widget. No pagination, no scrolling (V1
+;; non-goals): state in, [state event] out, string view.
+
+(ns tiny-tui.list
+  (:require [string]
+            [tiny-tui.style :as style]))
+
+(defn create
+  "opts: {:items [...] :item->text fn :empty-text \"...\"}"
+  [opts]
+  {:items (vec (:items opts))
+   :item->text (or (:item->text opts) str)
+   :empty-text (or (:empty-text opts) "No items.")
+   :cursor 0})
+
+(defn selected-index [l]
+  (when (seq (:items l))
+    (:cursor l)))
+
+(defn selected-item [l]
+  (when (seq (:items l))
+    (nth (:items l) (:cursor l))))
+
+(defn- move [l delta]
+  (let [n (count (:items l))]
+    (if (zero? n)
+      l
+      (assoc l :cursor (min (dec n) (max 0 (+ (:cursor l) delta)))))))
+
+(defn- select-event [l]
+  ;; Keyed off list non-emptiness, not item truthiness — nil/false are
+  ;; legitimate items.
+  (when (seq (:items l))
+    {:type :select
+     :item (selected-item l)
+     :index (:cursor l)}))
+
+(defn update
+  "Returns [new-state event]. Events: {:type :select ...} on enter,
+   {:type :cancel} on q/esc, nil otherwise."
+  [l msg]
+  (cond
+    (= msg :up) [(move l -1) nil]
+    (= msg :down) [(move l 1) nil]
+    (= msg :enter) [l (select-event l)]
+    (or (= msg "q") (= msg :esc)) [l {:type :cancel}]
+    :else [l nil]))
+
+(defn view [l]
+  (if (empty? (:items l))
+    (:empty-text l)
+    (string/join "\n"
+                 (map-indexed
+                   (fn [i item]
+                     (let [text ((:item->text l) item)]
+                       (if (= i (:cursor l))
+                         (str "› " (style/inverse text))
+                         (str "  " text))))
+                   (:items l)))))
diff --git a/src/tiny_tui/screen.lg b/src/tiny_tui/screen.lg
index 8fb67e4..30e5fde 100644
--- a/src/tiny_tui/screen.lg
+++ b/src/tiny_tui/screen.lg
@@ -1,80 +1,80 @@
 ;; tiny-tui.screen — terminal ownership: entering/leaving raw interactive
 ;; mode safely, and writing full frames.
 ;;
 ;; This is one of the two namespaces allowed to touch the terminal (the
 ;; other is tiny-tui.key). Everything else in tiny-tui is pure.
 ;;
 ;; Escape codes are built with (char 27) rather than written as literal
 ;; control characters, so the source stays readable and editing tools can't
 ;; corrupt it.
 
 (ns tiny-tui.screen
   (:require [string]
             [term]))
 
 (def ^:private ESC (str (char 27)))
 (def ^:private home (str ESC "[H"))
 (def ^:private clear-eol (str ESC "[K"))
 (def ^:private clear-below (str ESC "[J"))
 
 (defn frame-str
   "Build the ANSI string for one full-frame render of view string `s`:
    cursor home, each line followed by clear-to-end-of-line, lines joined
    with \\r\\n (raw mode needs the \\r), then clear everything below.
    Clearing per line instead of wiping the whole screen avoids flicker."
   [s]
   (let [lines (string/split s "\n")
         lines (if (empty? lines) [""] lines)]
     (str home
          (string/join (str clear-eol "\r\n") lines)
          clear-eol
          clear-below)))
 
 (defn shutdown!
   "Give the terminal back: restore style, cursor, main screen and cooked
    mode. Safe to call even if init! only partially succeeded."
   []
   (term/reset-style)
   (term/show-cursor)
   (term/main-screen)
   (term/flush)
   (term/restore-mode!))
 
 (defn init!
   "Take over the terminal: raw mode, alternate screen, hidden cursor.
    Throws when stdin/stdout is not a terminal (term/size returns nil).
    If setup fails after raw mode was enabled, the terminal is restored
    before the error propagates."
   []
   (when (nil? (term/size))
     (throw (ex-info "tiny-tui requires a terminal (stdin/stdout is not a tty)" {})))
   (term/raw-mode!)
   (try
     (term/alternate-screen)
     (term/hide-cursor)
     (term/clear)
     (term/flush)
     (catch e
-      (shutdown!)
+           (shutdown!)
       (throw e))))
 
 (defn render!
   "Write one full frame built from view string `s`."
   [s]
   (term/write (frame-str s))
   (term/flush))
 
 (defn clear!
   []
   (term/clear)
   (term/flush))
 
 (defmacro with-screen
   "Run `body` with the terminal in TUI mode, guaranteeing cleanup even when
    an exception escapes."
   [& body]
   (list 'do
         (list 'tiny-tui.screen/init!)
         (list 'try
               (cons 'do body)
               (list 'finally (list 'tiny-tui.screen/shutdown!)))))
diff --git a/test/tiny_tui/core_test.lg b/test/tiny_tui/core_test.lg
index dbd5ae8..1b607c8 100644
--- a/test/tiny_tui/core_test.lg
+++ b/test/tiny_tui/core_test.lg
@@ -1,81 +1,165 @@
 (ns tiny-tui.core-test
   (:require [clojure.test :refer :all]
-            [tiny-tui.core :as tui]))
+            [tiny-tui.core :as tui]
+            [tiny-tui.help :as help]
+            [tiny-tui.layout :as layout]
+            [tiny-tui.list :as tlist]
+            [tiny-tui.style :as style]))
 
 (defn scripted
   "Read-fn that returns the scripted messages one by one, then nil (EOF)."
   [msgs]
   (let [q (atom (seq msgs))]
     (fn []
       (let [m (first @q)]
         (swap! q rest)
         m))))
 
 (defn counter-app [frames]
   {:init {:count 0}
    :update (fn [state msg]
              (case msg
                :up [(update state :count inc) nil]
                :down [(update state :count dec) nil]
                "q" [state :quit]
                [state nil]))
    :view (fn [state] (str "Count: " (:count state)))
    :render-fn (fn [s] (swap! frames conj s))
    :screen false})
 
 (deftest test-run-counter
   (let [frames (atom [])
         [state event] (tui/run (assoc (counter-app frames)
                                       :read-key-fn (scripted [:up :up :down "q"])))]
     (is (= 1 (:count state)))
     (is (= :quit event))
     ;; one frame per loop iteration: initial + after each of the 3 moves
     (is (= 4 (count @frames)))
     (is (= "Count: 1" (last @frames)))))
 
 (deftest test-run-ctrl-c-quits-without-update
   (let [seen (atom [])
         app {:init {}
              :update (fn [state msg] (swap! seen conj msg) [state nil])
              :view (fn [_] "x")
              :render-fn (fn [_] nil)
              :screen false
              :read-key-fn (scripted [:ctrl-c])}
         [_ event] (tui/run app)]
     (is (= :ctrl-c event))
     (is (= [] @seen))))
 
 (deftest test-run-resize-rerenders-without-update
   (let [seen (atom [])
         frames (atom [])
         app {:init {}
              :update (fn [state msg] (swap! seen conj msg) [state :quit])
              :view (fn [_] "x")
              :render-fn (fn [s] (swap! frames conj s))
              :screen false
              :read-key-fn (scripted [:resize "q"])}]
     (tui/run app)
     (is (= ["q"] @seen))
     (is (= 2 (count @frames)))))
 
 (deftest test-run-injects-tui-size
   (let [sizes (atom [])
         app {:init {}
              :update (fn [state _] [state :quit])
              :view (fn [state] (swap! sizes conj (:tui/size state)) "x")
              :render-fn (fn [_] nil)
              :screen false
              :read-key-fn (scripted ["q"])}]
     (tui/run app)
     (is (= [[80 24]] @sizes))))
 
+(def projects
+  [{:name "tiny-cli"} {:name "tiny-tui"} {:name "lgx"}])
+
+(defn select-opts [script frames]
+  {:title "Choose project"
+   :items projects
+   :item->text :name
+   :read-key-fn (scripted script)
+   :render-fn (fn [s] (swap! frames conj s))
+   :screen false})
+
+(deftest test-select-picks-item
+  (is (= {:type :select
+          :item {:name "tiny-tui"}
+          :index 1}
+         (tui/select (select-opts [:down :enter] (atom []))))))
+
+(deftest test-select-cancel
+  (is (= {:type :cancel} (tui/select (select-opts ["q"] (atom [])))))
+  (is (= {:type :cancel} (tui/select (select-opts [:esc] (atom [])))))
+  (is (= {:type :cancel} (tui/select (select-opts [:ctrl-c] (atom [])))))
+  ;; EOF also cancels
+  (is (= {:type :cancel} (tui/select (select-opts [] (atom []))))))
+
+(deftest test-select-frame
+  (let [frames (atom [])]
+    (tui/select (select-opts ["q"] frames))
+    (is (= (layout/vstack
+             (style/bold "Choose project")
+             ""
+             (tlist/view (tlist/create {:items projects
+                                        :item->text :name}))
+             ""
+             (help/view [{:key "↑/↓"
+                          :label "navigate"}
+                         {:key "enter"
+                          :label "select"}
+                         {:key "q"
+                          :label "quit"}]))
+           (first @frames)))))
+
+(deftest test-select-without-title
+  (let [frames (atom [])]
+    (tui/select (assoc (select-opts ["q"] frames) :title nil))
+    (is (= (layout/vstack
+             (tlist/view (tlist/create {:items projects
+                                        :item->text :name}))
+             ""
+             (help/view [{:key "↑/↓"
+                          :label "navigate"}
+                         {:key "enter"
+                          :label "select"}
+                         {:key "q"
+                          :label "quit"}]))
+           (first @frames)))))
+
+(def delete-action
+  {:id :delete :key "d" :label "delete" :destructive? true})
+
+(deftest test-select-action-event
+  (is (= {:type :action
+          :action :delete
+          :item {:name "tiny-cli"}
+          :index 0
+          :destructive? true}
+         (tui/select (assoc (select-opts ["d"] (atom []))
+                            :actions [delete-action])))))
+
+(deftest test-select-frame-includes-action-help
+  (let [frames (atom [])
+        opts {:items projects :item->text :name :actions [delete-action]}]
+    (tui/select (merge (select-opts ["q"] frames) opts))
+    (is (= (layout/vstack
+            (style/bold "Choose project")
+            ""
+            (tlist/view (tlist/create opts))
+            ""
+            (help/view (tlist/bindings (tlist/create opts))))
+           (first @frames)))))
+
 (deftest test-run-eof-terminates
   (let [app {:init {:a 1}
              :update (fn [state _] [state nil])
              :view (fn [_] "x")
              :render-fn (fn [_] nil)
              :screen false
              :read-key-fn (scripted [])}
         [state event] (tui/run app)]
     (is (= 1 (:a state)))
     (is (nil? event))))
diff --git a/test/tiny_tui/key_test.lg b/test/tiny_tui/key_test.lg
