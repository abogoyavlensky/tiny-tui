++++ b/src/tiny_tui/help.lg
+@@ -0,0 +1,13 @@
++;; tiny-tui.help — render a one-line help bar from key bindings.
++
++(ns tiny-tui.help
++  (:require [string]
++            [tiny-tui.style :as style]))
++
++(defn view
++  "bindings: [{:key \"q\" :label \"quit\"} ...] ->
++   \"q quit   enter select\" with keys bold and labels dim."
++  [bindings]
++  (string/join "   "
++               (map (fn [b] (str (style/bold (:key b)) " " (style/dim (:label b))))
++                    bindings)))
+diff --git a/src/tiny_tui/key.lg b/src/tiny_tui/key.lg
+new file mode 100644
+index 0000000..ae76f76
+--- /dev/null
++++ b/src/tiny_tui/key.lg
+@@ -0,0 +1,53 @@
++;; tiny-tui.key — translate raw terminal input into simple messages:
++;; keywords for special keys (:up :down :enter :esc :ctrl-c ...), plain
++;; one-character strings for printable text.
++;;
++;; Only `read` touches the terminal; `parse` is pure and unit-tested.
++;; Control bytes are built with (char code) rather than written literally
++;; in source (mirrors legmacs.keys).
++
++(ns tiny-tui.key
++  (:require [term]))
++
++(def ^:private ESC (str (char 27)))
++
++(def ^:private special
++  (into {}
++        (concat
++          (map (fn [pair] [(str ESC (first pair)) (second pair)])
++               [["[A" :up] ["OA" :up]
++                ["[B" :down] ["OB" :down]
++                ["[C" :right] ["OC" :right]
++                ["[D" :left] ["OD" :left]
++                ["[H" :home] ["OH" :home] ["[1~" :home] ["[7~" :home]
++                ["[F" :end] ["OF" :end] ["[4~" :end] ["[8~" :end]
++                ["[3~" :delete]
++                ["[5~" :pageup]
++                ["[6~" :pagedown]])
++          [[(str (char 13)) :enter]
++           [(str (char 9)) :tab]
++           [(str (char 127)) :backspace]
++           [ESC :esc]
++           [(str (char 0)) :ctrl-space]
++          ;; BEL is term/read-key's synthetic resize wake-up, and also a
++          ;; genuine Ctrl-G — indistinguishable by design. Treating both as
++          ;; :resize is harmless: the loop just redraws.
++           [(str (char 7)) :resize]])))
++
++(defn- ctrl-key [code]
++  (keyword (str "ctrl-" (char (+ code 96)))))
++
++(defn parse
++  "Translate one term/read-key token into a message. Printable text passes
++   through unchanged."
++  [k]
++  (let [code (when (= 1 (count k)) (int (first (seq k))))]
++    (cond
++      (contains? special k) (get special k)
++      (and code (<= 1 code 26)) (ctrl-key code)
++      :else k)))
++
++(defn read
++  "Block for one key. Returns a message, or nil at end of input."
++  []
++  (some-> (term/read-key) parse))
+diff --git a/src/tiny_tui/layout.lg b/src/tiny_tui/layout.lg
+new file mode 100644
+index 0000000..ce8e6e1
+--- /dev/null
++++ b/src/tiny_tui/layout.lg
+@@ -0,0 +1,41 @@
++;; tiny-tui.layout — pure string layout helpers. All measurements use
++;; style/visible-width so styled text lays out correctly.
++
++(ns tiny-tui.layout
++  (:require [string]
++            [tiny-tui.style :as style]))
++
++(defn lines
++  [s]
++  (let [ls (string/split s "\n")]
++    (if (empty? ls) [""] (vec ls))))
++
++(defn vstack
++  "Stack blocks vertically, skipping nils. Blocks may be multi-line."
++  [& blocks]
++  (string/join "\n" (remove nil? blocks)))
++
++(defn hstack
++  "Join strings on one line, with `sep` (default two spaces) between them."
++  ([xs] (hstack "  " xs))
++  ([sep xs] (string/join sep xs)))
++
++(defn pad
++  "Right-pad `s` with spaces to visible width `w`."
++  [s w]
++  (let [n (- w (style/visible-width s))]
++    (if (pos? n)
++      (str s (apply str (repeat n " ")))
++      s)))
++
++(defn box
++  "Draw a box around (possibly multi-line, possibly styled) `content`,
++   sized to the widest visible line with one space of inner padding."
++  [content]
++  (let [ls (lines content)
++        w (apply max (map style/visible-width ls))
++        bar (apply str (repeat (+ 2 w) "─"))]
++    (string/join "\n"
++                 (concat [(str "┌" bar "┐")]
++                         (map #(str "│ " (pad % w) " │") ls)
++                         [(str "└" bar "┘")]))))
+diff --git a/src/tiny_tui/list.lg b/src/tiny_tui/list.lg
+new file mode 100644
+index 0000000..b644486
+--- /dev/null
++++ b/src/tiny_tui/list.lg
+@@ -0,0 +1,57 @@
++;; tiny-tui.list — a pure list widget. No pagination, no scrolling (V1
++;; non-goals): state in, [state event] out, string view.
++
++(ns tiny-tui.list
++  (:require [string]
++            [tiny-tui.style :as style]))
++
++(defn create
++  "opts: {:items [...] :item->text fn :empty-text \"...\"}"
++  [opts]
++  {:items (vec (:items opts))
++   :item->text (or (:item->text opts) str)
++   :empty-text (or (:empty-text opts) "No items.")
++   :cursor 0})
++
++(defn selected-index [l]
++  (when (seq (:items l))
++    (:cursor l)))
++
++(defn selected-item [l]
++  (when (seq (:items l))
++    (nth (:items l) (:cursor l))))
++
++(defn- move [l delta]
++  (let [n (count (:items l))]
++    (if (zero? n)
++      l
++      (assoc l :cursor (min (dec n) (max 0 (+ (:cursor l) delta)))))))
++
++(defn- select-event [l]
++  (when-let [item (selected-item l)]
++    {:type :select
++     :item item
++     :index (:cursor l)}))
++
++(defn update
++  "Returns [new-state event]. Events: {:type :select ...} on enter,
++   {:type :cancel} on q/esc, nil otherwise."
++  [l msg]
++  (cond
++    (= msg :up) [(move l -1) nil]
++    (= msg :down) [(move l 1) nil]
++    (= msg :enter) [l (select-event l)]
++    (or (= msg "q") (= msg :esc)) [l {:type :cancel}]
++    :else [l nil]))
++
++(defn view [l]
++  (if (empty? (:items l))
++    (:empty-text l)
++    (string/join "\n"
++                 (map-indexed
++                   (fn [i item]
++                     (let [text ((:item->text l) item)]
++                       (if (= i (:cursor l))
++                         (str "› " (style/inverse text))
++                         (str "  " text))))
++                   (:items l)))))
+diff --git a/src/tiny_tui/screen.lg b/src/tiny_tui/screen.lg
+index 8fb67e4..30e5fde 100644
+--- a/src/tiny_tui/screen.lg
++++ b/src/tiny_tui/screen.lg
+@@ -1,80 +1,80 @@
+ ;; tiny-tui.screen — terminal ownership: entering/leaving raw interactive
+ ;; mode safely, and writing full frames.
+ ;;
+ ;; This is one of the two namespaces allowed to touch the terminal (the
+ ;; other is tiny-tui.key). Everything else in tiny-tui is pure.
+ ;;
+ ;; Escape codes are built with (char 27) rather than written as literal
+ ;; control characters, so the source stays readable and editing tools can't
+ ;; corrupt it.
+ 
+ (ns tiny-tui.screen
+   (:require [string]
+             [term]))
+ 
+ (def ^:private ESC (str (char 27)))
+ (def ^:private home (str ESC "[H"))
+ (def ^:private clear-eol (str ESC "[K"))
+ (def ^:private clear-below (str ESC "[J"))
+ 
+ (defn frame-str
+   "Build the ANSI string for one full-frame render of view string `s`:
+    cursor home, each line followed by clear-to-end-of-line, lines joined
+    with \\r\\n (raw mode needs the \\r), then clear everything below.
+    Clearing per line instead of wiping the whole screen avoids flicker."
+   [s]
+   (let [lines (string/split s "\n")
+         lines (if (empty? lines) [""] lines)]
+     (str home
+          (string/join (str clear-eol "\r\n") lines)
+          clear-eol
+          clear-below)))
+ 
+ (defn shutdown!
+   "Give the terminal back: restore style, cursor, main screen and cooked
+    mode. Safe to call even if init! only partially succeeded."
+   []
+   (term/reset-style)
+   (term/show-cursor)
+   (term/main-screen)
+   (term/flush)
+   (term/restore-mode!))
+ 
+ (defn init!
+   "Take over the terminal: raw mode, alternate screen, hidden cursor.
+    Throws when stdin/stdout is not a terminal (term/size returns nil).
+    If setup fails after raw mode was enabled, the terminal is restored
+    before the error propagates."
+   []
+   (when (nil? (term/size))
+     (throw (ex-info "tiny-tui requires a terminal (stdin/stdout is not a tty)" {})))
+   (term/raw-mode!)
+   (try
+     (term/alternate-screen)
+     (term/hide-cursor)
+     (term/clear)
+     (term/flush)
+     (catch e
+-      (shutdown!)
++           (shutdown!)
+       (throw e))))
+ 
+ (defn render!
+   "Write one full frame built from view string `s`."
+   [s]
+   (term/write (frame-str s))
+   (term/flush))
+ 
+ (defn clear!
+   []
+   (term/clear)
+   (term/flush))
+ 
+ (defmacro with-screen
+   "Run `body` with the terminal in TUI mode, guaranteeing cleanup even when
+    an exception escapes."
+   [& body]
+   (list 'do
+         (list 'tiny-tui.screen/init!)
+         (list 'try
+               (cons 'do body)
+               (list 'finally (list 'tiny-tui.screen/shutdown!)))))
+diff --git a/src/tiny_tui/style.lg b/src/tiny_tui/style.lg
+new file mode 100644
+index 0000000..2c289a4
+--- /dev/null
++++ b/src/tiny_tui/style.lg
+@@ -0,0 +1,83 @@
++;; tiny-tui.style — pure ANSI text styling. Every function takes text and
++;; returns text wrapped in SGR escape sequences; nothing here touches the
++;; terminal (term/set-fg etc. write directly to stdout, which is the wrong
++;; shape for string-based views).
++;;
++;; Named colors use the portable 16-color codes; an integer color is passed
++;; through as 256-color. Escape bytes are built with (char 27), never
++;; written literally in source.
++
++(ns tiny-tui.style
++  (:require [string]))
++
++(def ^:private ESC (str (char 27)))
++(def ^:private esc-char (char 27))
++(def ^:private reset (str ESC "[0m"))
++
++(def ^:private color-codes
++  {:black 30
++   :red 31
++   :green 32
++   :yellow 33
++   :blue 34
++   :magenta 35
++   :cyan 36
++   :white 37
++   :bright-black 90
++   :bright-red 91
++   :bright-green 92
++   :bright-yellow 93
++   :bright-blue 94
++   :bright-magenta 95
++   :bright-cyan 96
++   :bright-white 97})
++
++(defn- fg-code [c]
++  (if (keyword? c)
++    (str (get color-codes c))
++    (str "38;5;" c)))
++
++(defn- bg-code [c]
++  (if (keyword? c)
++    (str (+ 10 (get color-codes c)))
++    (str "48;5;" c)))
++
++(defn- sgr [codes s]
++  (if (empty? codes)
++    s
++    (str ESC "[" (string/join ";" codes) "m" s reset)))
++
++(defn bold [s] (sgr ["1"] s))
++(defn dim [s] (sgr ["2"] s))
++(defn inverse [s] (sgr ["7"] s))
++(defn fg [c s] (sgr [(fg-code c)] s))
++(defn bg [c s] (sgr [(bg-code c)] s))
++
++(defn styled
++  "Apply several attributes at once as a single SGR sequence.
++   attrs: {:bold? :dim? :inverse? :fg :bg}"
++  [attrs s]
++  (sgr (remove nil?
++               [(when (:bold? attrs) "1")
++                (when (:dim? attrs) "2")
++                (when (:inverse? attrs) "7")
++                (when-let [c (:fg attrs)] (fg-code c))
++                (when-let [c (:bg attrs)] (bg-code c))])
++       s))
++
++(defn strip
++  "Remove all ESC[...m sequences, leaving the visible text."
++  [s]
++  (loop [cs (seq s) out []]
++    (if (empty? cs)
++      (apply str out)
++      (let [c (first cs)]
++        (if (= c esc-char)
++          (recur (rest (drop-while #(not= % \m) cs)) out)
++          (recur (rest cs) (conj out c)))))))
++
++(defn visible-width
++  "Display width of `s` ignoring escape sequences. Counts characters —
++   wide-rune handling is out of scope for V1."
++  [s]
++  (count (strip s)))
