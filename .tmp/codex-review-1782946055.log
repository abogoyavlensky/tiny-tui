    16	(def ^:private home (str ESC "[H"))
    17	(def ^:private clear-eol (str ESC "[K"))
    18	(def ^:private clear-below (str ESC "[J"))
    19	
    20	(defn frame-str
    21	  "Build the ANSI string for one full-frame render of view string `s`:
    22	   cursor home, each line followed by clear-to-end-of-line, lines joined
    23	   with \\r\\n (raw mode needs the \\r), then clear everything below.
    24	   Clearing per line instead of wiping the whole screen avoids flicker."
    25	  [s]
    26	  (let [lines (string/split s "\n")
    27	        lines (if (empty? lines) [""] lines)]
    28	    (str home
    29	         (string/join (str clear-eol "\r\n") lines)
    30	         clear-eol
    31	         clear-below)))
