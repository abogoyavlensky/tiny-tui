(ns tiny-tui.main
  (:require [tiny-tui.core :as tui]))

(def projects
  [{:id 1 :name "tiny-cli"}
   {:id 2 :name "tiny-tui"}
   {:id 3 :name "lgx"}])

(defn- main []
  (let [result (tui/select {:title "Select project"
                            :items projects
                            :item->text :name})]
    (println "Result:" result)))

; Top-level forms run during AOT compilation too. Guard so `lg -b` doesn't
; execute the CLI while bundling.
(when-not *compiling-aot*
  (main))
