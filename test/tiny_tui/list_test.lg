(ns tiny-tui.list-test
  (:require [clojure.test :refer :all]
            [string]
            [tiny-tui.list :as tlist]
            [tiny-tui.style :as style]))

(def projects
  [{:name "tiny-cli"} {:name "tiny-tui"} {:name "lgx"}])

(defn make []
  (tlist/create {:items projects
                 :item->text :name}))

(deftest test-create
  (let [l (make)]
    (is (= 0 (tlist/selected-index l)))
    (is (= {:name "tiny-cli"} (tlist/selected-item l)))))

(deftest test-cursor-moves-and-clamps
  (let [l (make)
        down (fn [l] (first (tlist/update l :down)))
        up (fn [l] (first (tlist/update l :up)))]
    (is (= 1 (tlist/selected-index (down l))))
    (is (= {:name "tiny-tui"} (tlist/selected-item (down l))))
    ;; clamped at the bottom
    (is (= 2 (tlist/selected-index (down (down (down (down l)))))))
    ;; clamped at the top
    (is (= 0 (tlist/selected-index (up l))))
    ;; moving returns no event
    (is (= nil (second (tlist/update l :down))))))

(deftest test-enter-selects
  (let [[l' event] (tlist/update (first (tlist/update (make) :down)) :enter)]
    (is (= {:type :select
            :item {:name "tiny-tui"}
            :index 1} event))
    (is (= 1 (tlist/selected-index l')))))

(deftest test-quit-and-esc-cancel
  (is (= {:type :cancel} (second (tlist/update (make) "q"))))
  (is (= {:type :cancel} (second (tlist/update (make) :esc)))))

(deftest test-unknown-message-ignored
  (let [l (make)
        [l' event] (tlist/update l "z")]
    (is (= l l'))
    (is (nil? event))))

(deftest test-view
  (is (= (string/join "\n"
                      [(str "› " (style/inverse "tiny-cli"))
                       "  tiny-tui"
                       "  lgx"])
         (tlist/view (make))))
  (is (= (string/join "\n"
                      ["  tiny-cli"
                       (str "› " (style/inverse "tiny-tui"))
                       "  lgx"])
         (tlist/view (first (tlist/update (make) :down))))))

(deftest test-item->text-defaults-to-str
  (let [l (tlist/create {:items ["a" "b"]})]
    (is (= (string/join "\n" [(str "› " (style/inverse "a")) "  b"])
           (tlist/view l)))))

(deftest test-falsey-items-are-selectable
  (let [l (tlist/create {:items [false nil true]})]
    (is (= {:type :select
            :item false
            :index 0}
           (second (tlist/update l :enter))))
    (is (= {:type :select
            :item nil
            :index 1}
           (second (tlist/update (first (tlist/update l :down)) :enter))))))

(def actions
  [{:id :open
    :key "o"
    :label "open"}
   {:id :delete
    :key "d"
    :label "delete"
    :destructive? true}])

(defn make-with-actions []
  (tlist/create {:items projects
                 :item->text :name
                 :actions actions}))

(deftest test-action-key-returns-action-event
  (let [l (first (tlist/update (make-with-actions) :down))]
    (is (= {:type :action
            :action :delete
            :item {:name "tiny-tui"}
            :index 1
            :destructive? true}
           (second (tlist/update l "d"))))))

(deftest test-non-destructive-action
  (is (= {:type :action
          :action :open
          :item {:name "tiny-cli"}
          :index 0}
         (second (tlist/update (make-with-actions) "o")))))

(deftest test-action-on-empty-list-ignored
  (let [l (tlist/create {:items []
                         :actions actions})]
    (is (nil? (second (tlist/update l "d"))))))

(deftest test-quit-still-cancels-with-actions
  (is (= {:type :cancel}
         (second (tlist/update (make-with-actions) "q")))))

(deftest test-bindings
  (is (= [{:key "↑/↓"
           :label "navigate"}
          {:key "enter"
           :label "select"}
          {:key "o"
           :label "open"}
          {:key "d"
           :label "delete"}
          {:key "q"
           :label "quit"}]
         (tlist/bindings (make-with-actions))))
  (is (= [{:key "↑/↓"
           :label "navigate"}
          {:key "enter"
           :label "select"}
          {:key "q"
           :label "quit"}]
         (tlist/bindings (make)))))

(deftest test-custom-cursor-marker
  (let [l (tlist/create {:items ["a" "b"]
                         :cursor-marker "→ "})]
    (is (= (string/join "\n" [(str "→ " (style/inverse "a")) "  b"])
           (tlist/view l)))))

(deftest test-custom-selected-style
  (let [l (tlist/create {:items ["a" "b"]
                         :selected-style (fn [s] (style/fg :cyan s))})]
    (is (= (string/join "\n" [(str "› " (style/fg :cyan "a")) "  b"])
           (tlist/view l)))))

(deftest test-width-truncation
  (let [l (tlist/create {:items ["abcdefghijkl" "ab"]})]
    ;; marker (2) + 7 chars + ellipsis = 10 columns
    (is (= (string/join "\n" [(str "› " (style/inverse "abcdefg…")) "  ab"])
           (tlist/view l {:width 10})))
    ;; no width -> no truncation
    (is (= (string/join "\n" [(str "› " (style/inverse "abcdefghijkl")) "  ab"])
           (tlist/view l)))
    ;; wide enough -> untouched
    (is (= (string/join "\n" [(str "› " (style/inverse "abcdefghijkl")) "  ab"])
           (tlist/view l {:width 40})))
    ;; a width too small to truncate into (e.g. a misreported terminal
    ;; size) must not crash — text is left alone
    (is (= (string/join "\n" [(str "› " (style/inverse "abcdefghijkl")) "  ab"])
           (tlist/view l {:width 0})))
    (is (= (string/join "\n" [(str "› " (style/inverse "abcdefghijkl")) "  ab"])
           (tlist/view l {:width 3})))))

(deftest test-styled-item-text-never-truncated
  ;; cutting styled text by raw index could split an escape sequence, so
  ;; it is left intact even when over budget
  (let [styled (style/fg :cyan "abcdefghijkl")
        l (tlist/create {:items [styled]
                         :item->text identity})]
    (is (= (str "› " (style/inverse styled))
           (tlist/view l {:width 10})))))

(deftest test-empty-list
  (let [l (tlist/create {:items []})]
    (is (= "No items." (tlist/view l)))
    (is (nil? (tlist/selected-item l)))
    (is (nil? (tlist/selected-index l)))
    (is (nil? (second (tlist/update l :enter))))
    (is (= l (first (tlist/update l :down)))))
  (let [l (tlist/create {:items []
                         :empty-text "Nothing here"})]
    (is (= "Nothing here" (tlist/view l)))))

(defn make50 []
  (tlist/create {:items (vec (map (fn [i] (str "item-" i)) (range 50)))}))

(deftest test-window-nil-height-shows-all
  (is (= {:start 0
          :end 50
          :windowed? false
          :indicator nil}
         (tlist/window (make50) nil))))

(deftest test-window-fits-not-windowed
  (let [l (tlist/create {:items ["a" "b" "c"]})]
    (is (= {:start 0
            :end 3
            :windowed? false
            :indicator nil}
           (tlist/window l 10)))))

(deftest test-window-top
  ;; h 10, windowed -> body 9; cursor 0 -> start 0, end 9
  (is (= {:start 0
          :end 9
          :windowed? true
          :indicator "1/50"}
         (tlist/window (make50) 10))))

(deftest test-window-scrolled-past-bottom
  ;; cursor 20, offset 0, body 9 -> start 20-8=12, end 21
  (let [l (assoc (make50) :cursor 20 :offset 0)]
    (is (= {:start 12
            :end 21
            :windowed? true
            :indicator "21/50"}
           (tlist/window l 10)))))

(deftest test-window-scrolled-above-offset
  ;; cursor 5, offset 30 -> start clamps down to cursor
  (let [l (assoc (make50) :cursor 5 :offset 30)]
    (is (= 5 (:start (tlist/window l 10))))))

(deftest test-window-height-one-no-indicator
  ;; h 1 -> body 1, single item, no room for an indicator
  (let [l (assoc (make50) :cursor 0 :offset 0)]
    (is (= {:start 0
            :end 1
            :windowed? true
            :indicator nil}
           (tlist/window l 1)))))

(deftest test-reconcile-offset-persists-start
  (let [l (assoc (make50) :cursor 20 :offset 0)]
    (is (= (:start (tlist/window l 10))
           (:offset (tlist/reconcile-offset l 10)))))
  ;; nil height leaves offset at 0
  (is (= 0 (:offset (tlist/reconcile-offset (make50) nil)))))
