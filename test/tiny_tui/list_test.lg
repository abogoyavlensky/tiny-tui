(ns tiny-tui.list-test
  (:require [clojure.test :refer :all]
            [string]
            [tiny-tui.list :as tlist]
            [tiny-tui.style :as style]))

(def projects
  [{:name "tiny-cli"} {:name "tiny-tui"} {:name "lgx"}])

(defn make []
  (tlist/create {:items projects
                 :item->text :name}))

(deftest test-create
  (let [l (make)]
    (is (= 0 (tlist/selected-index l)))
    (is (= {:name "tiny-cli"} (tlist/selected-item l)))))

(deftest test-cursor-moves-and-clamps
  (let [l (make)
        down (fn [l] (first (tlist/update l :down)))
        up (fn [l] (first (tlist/update l :up)))]
    (is (= 1 (tlist/selected-index (down l))))
    (is (= {:name "tiny-tui"} (tlist/selected-item (down l))))
    ;; clamped at the bottom
    (is (= 2 (tlist/selected-index (down (down (down (down l)))))))
    ;; clamped at the top
    (is (= 0 (tlist/selected-index (up l))))
    ;; moving returns no event
    (is (= nil (second (tlist/update l :down))))))

(deftest test-enter-selects
  (let [[l' event] (tlist/update (first (tlist/update (make) :down)) :enter)]
    (is (= {:type :select
            :item {:name "tiny-tui"}
            :index 1} event))
    (is (= 1 (tlist/selected-index l')))))

(deftest test-quit-and-esc-cancel
  (is (= {:type :cancel} (second (tlist/update (make) "q"))))
  (is (= {:type :cancel} (second (tlist/update (make) :esc)))))

(deftest test-unknown-message-ignored
  (let [l (make)
        [l' event] (tlist/update l "z")]
    (is (= l l'))
    (is (nil? event))))

(deftest test-view
  (is (= (string/join "\n"
                      [(str "› " (style/inverse "tiny-cli"))
                       "  tiny-tui"
                       "  lgx"])
         (tlist/view (make))))
  (is (= (string/join "\n"
                      ["  tiny-cli"
                       (str "› " (style/inverse "tiny-tui"))
                       "  lgx"])
         (tlist/view (first (tlist/update (make) :down))))))

(deftest test-item->text-defaults-to-str
  (let [l (tlist/create {:items ["a" "b"]})]
    (is (= (string/join "\n" [(str "› " (style/inverse "a")) "  b"])
           (tlist/view l)))))

(deftest test-falsey-items-are-selectable
  (let [l (tlist/create {:items [false nil true]})]
    (is (= {:type :select
            :item false
            :index 0}
           (second (tlist/update l :enter))))
    (is (= {:type :select
            :item nil
            :index 1}
           (second (tlist/update (first (tlist/update l :down)) :enter))))))

(def actions
  [{:id :open
    :key "o"
    :label "open"}
   {:id :delete
    :key "d"
    :label "delete"
    :destructive? true}])

(defn make-with-actions []
  (tlist/create {:items projects
                 :item->text :name
                 :actions actions}))

(deftest test-action-key-returns-action-event
  (let [l (first (tlist/update (make-with-actions) :down))]
    (is (= {:type :action
            :action :delete
            :item {:name "tiny-tui"}
            :index 1
            :destructive? true}
           (second (tlist/update l "d"))))))

(deftest test-non-destructive-action
  (is (= {:type :action
          :action :open
          :item {:name "tiny-cli"}
          :index 0}
         (second (tlist/update (make-with-actions) "o")))))

(deftest test-action-on-empty-list-ignored
  (let [l (tlist/create {:items []
                         :actions actions})]
    (is (nil? (second (tlist/update l "d"))))))

(deftest test-quit-still-cancels-with-actions
  (is (= {:type :cancel}
         (second (tlist/update (make-with-actions) "q")))))

(deftest test-bindings
  (is (= [{:key "↑/↓"
           :label "navigate"}
          {:key "enter"
           :label "select"}
          {:key "o"
           :label "open"}
          {:key "d"
           :label "delete"}
          {:key "q"
           :label "quit"}]
         (tlist/bindings (make-with-actions))))
  (is (= [{:key "↑/↓"
           :label "navigate"}
          {:key "enter"
           :label "select"}
          {:key "q"
           :label "quit"}]
         (tlist/bindings (make)))))

(deftest test-custom-cursor-marker
  (let [l (tlist/create {:items ["a" "b"]
                         :cursor-marker "→ "})]
    (is (= (string/join "\n" [(str "→ " (style/inverse "a")) "  b"])
           (tlist/view l)))))

(deftest test-custom-selected-style
  (let [l (tlist/create {:items ["a" "b"]
                         :selected-style (fn [s] (style/fg :cyan s))})]
    (is (= (string/join "\n" [(str "› " (style/fg :cyan "a")) "  b"])
           (tlist/view l)))))

(deftest test-width-truncation
  (let [l (tlist/create {:items ["abcdefghijkl" "ab"]})]
    ;; marker (2) + 7 chars + ellipsis = 10 columns
    (is (= (string/join "\n" [(str "› " (style/inverse "abcdefg…")) "  ab"])
           (tlist/view l {:width 10})))
    ;; no width -> no truncation
    (is (= (string/join "\n" [(str "› " (style/inverse "abcdefghijkl")) "  ab"])
           (tlist/view l)))
    ;; wide enough -> untouched
    (is (= (string/join "\n" [(str "› " (style/inverse "abcdefghijkl")) "  ab"])
           (tlist/view l {:width 40})))
    ;; a width too small to truncate into (e.g. a misreported terminal
    ;; size) must not crash — text is left alone
    (is (= (string/join "\n" [(str "› " (style/inverse "abcdefghijkl")) "  ab"])
           (tlist/view l {:width 0})))
    (is (= (string/join "\n" [(str "› " (style/inverse "abcdefghijkl")) "  ab"])
           (tlist/view l {:width 3})))))

(deftest test-styled-item-text-never-truncated
  ;; cutting styled text by raw index could split an escape sequence, so
  ;; it is left intact even when over budget
  (let [styled (style/fg :cyan "abcdefghijkl")
        l (tlist/create {:items [styled]
                         :item->text identity})]
    (is (= (str "› " (style/inverse styled))
           (tlist/view l {:width 10})))))

(deftest test-empty-list
  (let [l (tlist/create {:items []})]
    (is (= "No items." (tlist/view l)))
    (is (nil? (tlist/selected-item l)))
    (is (nil? (tlist/selected-index l)))
    (is (nil? (second (tlist/update l :enter))))
    (is (= l (first (tlist/update l :down)))))
  (let [l (tlist/create {:items []
                         :empty-text "Nothing here"})]
    (is (= "Nothing here" (tlist/view l)))))

(defn make50 []
  (tlist/create {:items (vec (map (fn [i] (str "item-" i)) (range 50)))}))

(deftest test-window-nil-height-shows-all
  (is (= {:start 0
          :end 50
          :windowed? false
          :indicator nil}
         (tlist/window (make50) nil))))

(deftest test-window-fits-not-windowed
  (let [l (tlist/create {:items ["a" "b" "c"]})]
    (is (= {:start 0
            :end 3
            :windowed? false
            :indicator nil}
           (tlist/window l 10)))))

(deftest test-window-top
  ;; h 10, windowed -> body 9; cursor 0 -> start 0, end 9
  (is (= {:start 0
          :end 9
          :windowed? true
          :indicator "1/50"}
         (tlist/window (make50) 10))))

(deftest test-window-scrolled-past-bottom
  ;; cursor 20, offset 0, body 9 -> start 20-8=12, end 21
  (let [l (assoc (make50) :cursor 20 :offset 0)]
    (is (= {:start 12
            :end 21
            :windowed? true
            :indicator "21/50"}
           (tlist/window l 10)))))

(deftest test-window-scrolled-above-offset
  ;; cursor 5, offset 30 -> start clamps down to cursor
  (let [l (assoc (make50) :cursor 5 :offset 30)]
    (is (= 5 (:start (tlist/window l 10))))))

(deftest test-window-height-one-no-indicator
  ;; h 1 -> body 1, single item, no room for an indicator
  (let [l (assoc (make50) :cursor 0 :offset 0)]
    (is (= {:start 0
            :end 1
            :windowed? true
            :indicator nil}
           (tlist/window l 1)))))

(deftest test-reconcile-offset-persists-start
  (let [l (assoc (make50) :cursor 20 :offset 0)]
    (is (= (:start (tlist/window l 10))
           (:offset (tlist/reconcile-offset l 10)))))
  ;; nil height leaves offset at 0
  (is (= 0 (:offset (tlist/reconcile-offset (make50) nil)))))

(defn make5 []
  (tlist/create {:items ["a" "b" "c" "d" "e"]}))

(deftest test-view-windowed-top
  ;; h 3 -> body 2 + indicator; cursor 0 shows items 0,1 and a dim "1/5"
  (is (= (string/join "\n"
                      [(str "› " (style/inverse "a"))
                       "  b"
                       (style/dim "1/5")])
         (tlist/view (make5) {:height 3}))))

(deftest test-view-windowed-scrolled
  ;; cursor at the bottom, offset reconciled the way core does it
  (let [l (tlist/reconcile-offset (assoc (make5) :cursor 4) 3)]
    (is (= (string/join "\n"
                        ["  d"
                         (str "› " (style/inverse "e"))
                         (style/dim "5/5")])
           (tlist/view l {:height 3})))))

(deftest test-view-height-fits-no-indicator
  ;; height large enough for all items -> identical to the no-height render
  (is (= (tlist/view (make5))
         (tlist/view (make5) {:height 10}))))

(deftest test-view-height-one-single-item-no-indicator
  (is (= (str "› " (style/inverse "a"))
         (tlist/view (make5) {:height 1}))))

(deftest test-view-empty-with-height
  (is (= "No items."
         (tlist/view (tlist/create {:items []}) {:height 5}))))

(def fruits ["Apple" "banana" "Cherry" "apricot" "Blueberry"])

(defn make-filterable [extra]
  (tlist/create (merge {:items fruits
                        :filterable? true} extra)))

(deftest test-create-filterable-defaults
  (let [l (make-filterable {})]
    (is (= true (:filterable? l)))
    (is (= "" (:query l)))
    (is (= [0 1 2 3 4] (:filtered l)))))

(deftest test-create-non-filterable-has-identity-filtered
  (let [l (tlist/create {:items fruits})]
    (is (= [0 1 2 3 4] (:filtered l)))))

(deftest test-refilter-substring-case-insensitive
  ;; "ap" matches "Apple" (0) and "apricot" (3)
  (let [l (tlist/refilter (assoc (make-filterable {}) :query "ap"))]
    (is (= [0 3] (:filtered l))))
  ;; "rr" matches "Cherry" (2) and "Blueberry" (4)
  (let [l (tlist/refilter (assoc (make-filterable {}) :query "rr"))]
    (is (= [2 4] (:filtered l)))))

(deftest test-refilter-resets-cursor-and-offset
  (let [l (tlist/refilter (assoc (make-filterable {}) :query "b" :cursor 3 :offset 2))]
    ;; "b" matches banana (1) and Blueberry (4)
    (is (= [1 4] (:filtered l)))
    (is (= 0 (:cursor l)))
    (is (= 0 (:offset l)))))

(deftest test-refilter-empty-query-matches-all
  (let [l (tlist/refilter (assoc (make-filterable {}) :query ""))]
    (is (= [0 1 2 3 4] (:filtered l)))))

(deftest test-refilter-custom-filter-fn
  ;; prefix match instead of substring: "a" starts only "Apple"/"apricot"
  (let [prefix (fn [q item] (string/starts-with? (string/lower-case item)
                                                 (string/lower-case q)))
        l (tlist/refilter (assoc (make-filterable {:filter-fn prefix}) :query "a"))]
    (is (= [0 3] (:filtered l)))))

(defn type-in [l chars]
  (reduce (fn [st c] (first (tlist/update st c))) l chars))

(deftest test-typing-narrows
  (let [l (type-in (make-filterable {}) ["a" "p"])]
    (is (= "ap" (:query l)))
    (is (= [0 3] (:filtered l)))))

(deftest test-q-types-not-cancels-when-filterable
  (let [r (tlist/update (make-filterable {}) "q")]
    (is (= "q" (:query (first r))))
    (is (nil? (second r)))))

(deftest test-backspace-widens
  (let [l (type-in (make-filterable {}) ["a" "p" :backspace])]
    (is (= "a" (:query l)))
    ;; "a" (substring) matches Apple(0), banana(1), apricot(3)
    (is (= [0 1 3] (:filtered l)))))

(deftest test-filterable-enter-selects-original-index
  ;; narrow to "rr" -> Cherry(2), Blueberry(4); enter picks the first match
  (let [l (type-in (make-filterable {}) ["r" "r"])
        event (second (tlist/update l :enter))]
    (is (= {:type :select
            :item "Cherry"
            :index 2} event))))

(deftest test-filterable-down-then-enter
  ;; "rr" -> [2 4]; down moves to Blueberry(4)
  (let [l (first (tlist/update (type-in (make-filterable {}) ["r" "r"]) :down))]
    (is (= "Blueberry" (tlist/selected-item l)))
    (is (= 4 (tlist/selected-index l)))
    (is (= {:type :select
            :item "Blueberry"
            :index 4}
           (second (tlist/update l :enter))))))

(deftest test-filterable-esc-cancels
  (is (= {:type :cancel} (second (tlist/update (make-filterable {}) :esc)))))

(deftest test-filterable-no-match-has-no-selection
  (let [l (type-in (make-filterable {}) ["z" "z"])]
    (is (= [] (:filtered l)))
    (is (nil? (tlist/selected-item l)))
    (is (nil? (tlist/selected-index l)))
    (is (nil? (second (tlist/update l :enter))))))

(deftest test-filterable-down-clamps-to-matches
  ;; "rr" -> 2 matches; repeated down clamps at the last match (index 1 -> Blueberry)
  (let [l (type-in (make-filterable {}) ["r" "r"])
        l (first (tlist/update (first (tlist/update l :down)) :down))]
    (is (= 1 (:cursor l)))
    (is (= "Blueberry" (tlist/selected-item l)))))

(deftest test-window-counts-filtered
  ;; window measures the match set, not the original items
  (let [l (assoc (make-filterable {}) :filtered [2 4] :cursor 0 :offset 0)]
    (is (= {:start 0
            :end 2
            :windowed? false
            :indicator nil}
           (tlist/window l 10)))))

(deftest test-view-filterable-shows-query-line
  (is (= (string/join "\n"
                      [(str "> " (style/inverse " "))
                       (str "› " (style/inverse "Apple"))
                       "  banana"
                       "  Cherry"
                       "  apricot"
                       "  Blueberry"])
         (tlist/view (make-filterable {})))))

(deftest test-view-filterable-narrowed
  (let [l (type-in (make-filterable {}) ["r" "r"])]
    (is (= (string/join "\n"
                        [(str "> rr" (style/inverse " "))
                         (str "› " (style/inverse "Cherry"))
                         "  Blueberry"])
           (tlist/view l)))))

(deftest test-view-filterable-no-match
  (let [l (type-in (make-filterable {}) ["z" "z"])]
    (is (= (string/join "\n"
                        [(str "> zz" (style/inverse " "))
                         (style/dim "No matches")])
           (tlist/view l)))))

(deftest test-view-filterable-windowed-reserves-query-row
  ;; height 4 -> 1 query row + 2 item rows + indicator; cursor 0
  (is (= (string/join "\n"
                      [(str "> " (style/inverse " "))
                       (str "› " (style/inverse "Apple"))
                       "  banana"
                       (style/dim "1/5")])
         (tlist/view (make-filterable {}) {:height 4}))))

(deftest test-bindings-filterable
  (is (= [{:key "↑/↓"
           :label "navigate"}
          {:key "enter"
           :label "select"}
          {:key "esc"
           :label "cancel"}]
         (tlist/bindings (make-filterable {})))))

(deftest test-view-filterable-height-one-query-only
  ;; a single-row block spends its only row on the query line, no items
  (is (= (str "> " (style/inverse " "))
         (tlist/view (make-filterable {}) {:height 1}))))

(deftest test-view-filterable-empty-list-uses-empty-text
  ;; genuinely empty (nothing to filter) -> :empty-text, not "No matches"
  (let [l (tlist/create {:items []
                         :filterable? true
                         :empty-text "Nothing here"})]
    (is (= "Nothing here" (tlist/view l)))))

(deftest test-view-filterable-height-one-no-match-query-only
  ;; even with zero matches, a one-row block shows only the query line
  (let [l (type-in (make-filterable {}) ["z" "z"])]
    (is (= (str "> zz" (style/inverse " "))
           (tlist/view l {:height 1})))))

(def ctrl-actions
  [{:id :delete
    :key :ctrl-d
    :label "delete"
    :destructive? true}])

(deftest test-filterable-ctrl-action-fires-while-typing
  ;; type to narrow, then a control-key action fires on the highlighted match
  (let [l (type-in (tlist/create {:items fruits
                                  :filterable? true
                                  :actions ctrl-actions})
                   ["r" "r"])]
    (is (= {:type :action
            :action :delete
            :item "Cherry"
            :index 2
            :destructive? true}
           (second (tlist/update l :ctrl-d))))))

(deftest test-filterable-letter-action-is-shadowed
  ;; a plain-letter action key still types into the query (does not fire)
  (let [l (tlist/create {:items fruits
                         :filterable? true
                         :actions [{:id :delete
                                    :key "d"
                                    :label "delete"}]})
        r (tlist/update l "d")]
    (is (= "d" (:query (first r))))
    (is (nil? (second r)))))

(deftest test-bindings-filterable-shows-ctrl-actions
  (is (= [{:key "↑/↓"
           :label "navigate"}
          {:key "enter"
           :label "select"}
          {:key "^d"
           :label "delete"}
          {:key "esc"
           :label "cancel"}]
         (tlist/bindings (tlist/create {:items fruits
                                        :filterable? true
                                        :actions ctrl-actions})))))

(deftest test-bindings-filterable-hides-letter-actions
  ;; a letter action can't fire while filtering, so it's dropped from help
  (is (= [{:key "↑/↓"
           :label "navigate"}
          {:key "enter"
           :label "select"}
          {:key "esc"
           :label "cancel"}]
         (tlist/bindings (tlist/create {:items fruits
                                        :filterable? true
                                        :actions [{:id :delete
                                                   :key "d"
                                                   :label "delete"}]})))))

(deftest test-bindings-formats-ctrl-key-label
  ;; ^d rendering applies to non-filterable lists too (string keys unchanged)
  (is (= {:key "^d"
          :label "delete"}
         (nth (tlist/bindings (tlist/create {:items fruits
                                             :actions ctrl-actions})) 2))))

(deftest test-bindings-filterable-hides-reserved-key-actions
  ;; an action bound to a key the filter loop intercepts (e.g. :enter) never
  ;; fires, so it must not be advertised
  (let [l (tlist/create {:items fruits
                         :filterable? true
                         :actions [{:id :pick
                                    :key :enter
                                    :label "pick"}
                                   {:id :delete
                                    :key :ctrl-d
                                    :label "delete"}]})]
    (is (= [{:key "↑/↓"
             :label "navigate"}
            {:key "enter"
             :label "select"}
            {:key "^d"
             :label "delete"}
            {:key "esc"
             :label "cancel"}]
           (tlist/bindings l)))))

(deftest test-set-items-replaces-and-clamps-cursor
  ;; cursor past the new end clamps to the last item
  (let [l (assoc (tlist/create {:items ["a" "b" "c" "d" "e"]}) :cursor 4)
        l' (tlist/set-items l ["x" "y" "z"])]
    (is (= ["x" "y" "z"] (:items l')))
    (is (= [0 1 2] (:filtered l')))
    (is (= 2 (:cursor l')))))

(deftest test-set-items-preserves-in-range-cursor
  (let [l (assoc (tlist/create {:items ["a" "b" "c" "d" "e"]}) :cursor 1)
        l' (tlist/set-items l ["p" "q" "r" "s"])]
    (is (= 1 (:cursor l')))))

(deftest test-set-items-reapplies-filter-query
  ;; a filterable list with query "b" over new items keeps only matches
  (let [l (assoc (tlist/create {:items fruits
                                :filterable? true}) :query "b")
        l' (tlist/set-items l ["blueberry" "cherry" "banana"])]
    ;; "b" matches blueberry(0) and banana(2)
    (is (= [0 2] (:filtered l')))
    (is (= "blueberry" (tlist/selected-item l')))))

(deftest test-set-items-empty
  (let [l (assoc (tlist/create {:items ["a" "b" "c"]}) :cursor 2)
        l' (tlist/set-items l [])]
    (is (= [] (:filtered l')))
    (is (= 0 (:cursor l')))
    (is (nil? (tlist/selected-item l')))))

(defn make-multi [extra]
  (tlist/create (merge {:items ["a" "b" "c" "d"]
                        :multi? true} extra)))

(deftest test-create-multi-defaults
  (let [l (make-multi {})]
    (is (= true (:multi? l)))
    (is (= #{} (:selected l)))))

(deftest test-space-toggles-current
  (let [l (make-multi {})
        on (first (tlist/update l " "))]
    (is (= #{0} (:selected on)))
    ;; toggling again removes it
    (is (= #{} (:selected (first (tlist/update on " ")))))
    ;; space emits no event
    (is (nil? (second (tlist/update l " "))))))

(deftest test-toggle-then-navigate-then-toggle
  (let [l (make-multi {})
        l (first (tlist/update l " "))          ; select 0
        l (first (tlist/update l :down))        ; cursor -> 1
        l (first (tlist/update l :down))        ; cursor -> 2
        l (first (tlist/update l " "))]         ; select 2
    (is (= #{0 2} (:selected l)))))

(deftest test-selection-stable-across-filtering
  ;; multi + filterable: toggle a row, then narrow; the original index persists
  (let [l (tlist/create {:items fruits
                         :multi? true
                         :filterable? true})
        l (first (tlist/update l :down))        ; cursor -> banana (index 1)
        l (first (tlist/update l " "))          ; select banana (orig index 1)
        l (type-in l ["r" "r"])]                ; narrow to Cherry(2)/Blueberry(4)
    (is (contains? (:selected l) 1))))

(deftest test-enter-submits-selected-in-order
  ;; toggle index 2 then index 0 -> submit lists them index-ordered
  (let [l (make-multi {})
        l (first (tlist/update (first (tlist/update l :down)) :down)) ; cursor -> 2
        l (first (tlist/update l " "))          ; select 2
        l (first (tlist/update (first (tlist/update l :up)) :up))     ; cursor -> 0
        l (first (tlist/update l " "))]         ; select 0
    (is (= {:type :submit
            :items ["a" "c"]
            :indices [0 2]}
           (second (tlist/update l :enter))))))

(deftest test-enter-submits-empty-set
  (is (= {:type :submit
          :items []
          :indices []}
         (second (tlist/update (make-multi {}) :enter)))))

(deftest test-set-items-clears-selection
  ;; replacing items invalidates :selected indices, so it resets
  (let [l (first (tlist/update (make-multi {}) " "))]  ; select index 0
    (is (= #{0} (:selected l)))
    (is (= #{} (:selected (tlist/set-items l ["x" "y"]))))))
