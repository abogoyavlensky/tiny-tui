(ns tiny-tui.key-test
  (:require [clojure.test :refer :all]
            [tiny-tui.key :as key]))

(def ESC (str (char 27)))

(deftest test-parse-arrows
  (is (= :up (key/parse (str ESC "[A"))))
  (is (= :up (key/parse (str ESC "OA"))))
  (is (= :down (key/parse (str ESC "[B"))))
  (is (= :down (key/parse (str ESC "OB"))))
  (is (= :right (key/parse (str ESC "[C"))))
  (is (= :left (key/parse (str ESC "[D")))))

(deftest test-parse-nav-keys
  (is (= :home (key/parse (str ESC "[H"))))
  (is (= :home (key/parse (str ESC "[1~"))))
  (is (= :end (key/parse (str ESC "[F"))))
  (is (= :end (key/parse (str ESC "[4~"))))
  (is (= :delete (key/parse (str ESC "[3~")))))

(deftest test-parse-named-keys
  (is (= :enter (key/parse (str (char 13)))))
  (is (= :enter (key/parse (str (char 10)))))
  (is (= :tab (key/parse (str (char 9)))))
  (is (= :backspace (key/parse (str (char 127)))))
  (is (= :esc (key/parse ESC))))

(deftest test-parse-control-keys
  (is (= :ctrl-c (key/parse (str (char 3)))))
  (is (= :ctrl-a (key/parse (str (char 1)))))
  (is (= :ctrl-space (key/parse (str (char 0)))))
  ;; BEL doubles as term/read-key's resize wake-up
  (is (= :resize (key/parse (str (char 7))))))

(deftest test-parse-printables-pass-through
  (is (= "q" (key/parse "q")))
  (is (= "d" (key/parse "d")))
  (is (= " " (key/parse " "))))

(deftest test-parse-word-motion-csi
  ;; Ctrl+Arrow (…;5…) and Option/Alt+Arrow (…;3…) both mean word motion.
  (is (= :word-left (key/parse (str ESC "[1;3D"))))
  (is (= :word-left (key/parse (str ESC "[1;5D"))))
  (is (= :word-right (key/parse (str ESC "[1;3C"))))
  (is (= :word-right (key/parse (str ESC "[1;5C"))))
  ;; Alt+Delete (…;3…) and Ctrl+Delete (…;5…) both delete a word forward.
  (is (= :delete-word (key/parse (str ESC "[3;3~"))))
  (is (= :delete-word (key/parse (str ESC "[3;5~")))))

(deftest test-parse-alt-chords
  ;; parse-alt takes the *inner* token that followed a same-burst ESC and
  ;; maps the Alt chord to a word message (macOS Option keys, mainly).
  (is (= :word-left (key/parse-alt "b")))          ; Option+Left  -> ESC b
  (is (= :word-right (key/parse-alt "f")))         ; Option+Right -> ESC f
  (is (= :delete-word (key/parse-alt "d")))        ; Alt+d
  (is (= :backspace-word (key/parse-alt (str (char 127)))))  ; Option+Backspace -> ESC DEL
  ;; Alt + a CSI arrow (ESC ESC [ D) -> word motion
  (is (= :word-left (key/parse-alt (str ESC "[D"))))
  (is (= :word-right (key/parse-alt (str ESC "[C"))))
  ;; Alt+Esc collapses back to a plain :esc (never cancels via a stray chord)
  (is (= :esc (key/parse-alt ESC)))
  ;; any other Alt+printable is an inert :alt-<char>, never :esc
  (is (= :alt-x (key/parse-alt "x")))
  ;; Alt + an unmapped special key falls through to the inner parse
  (is (= :enter (key/parse-alt (str (char 13))))))
