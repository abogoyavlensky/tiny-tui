(ns tiny-tui.core-test
  (:require [clojure.test :refer :all]
            [string]
            [tiny-tui.confirm :as tconfirm]
            [tiny-tui.core :as tui]
            [tiny-tui.help :as help]
            [tiny-tui.layout :as layout]
            [tiny-tui.list :as tlist]
            [tiny-tui.style :as style]))

(defn scripted
  "Read-fn that returns the scripted messages one by one, then nil (EOF)."
  [msgs]
  (let [q (atom (seq msgs))]
    (fn []
      (let [m (first @q)]
        (swap! q rest)
        m))))

(defn counter-app [frames]
  {:init {:count 0}
   :update (fn [state msg]
             (case msg
               :up [(update state :count inc) nil]
               :down [(update state :count dec) nil]
               "q" [state :quit]
               [state nil]))
   :view (fn [state] (str "Count: " (:count state)))
   :render-fn (fn [s] (swap! frames conj s))
   :screen false})

(deftest test-run-counter
  (let [frames (atom [])
        [state event] (tui/run (assoc (counter-app frames)
                                      :read-key-fn (scripted [:up :up :down "q"])))]
    (is (= 1 (:count state)))
    (is (= :quit event))
    ;; one frame per loop iteration: initial + after each of the 3 moves
    (is (= 4 (count @frames)))
    (is (= "Count: 1" (last @frames)))))

(deftest test-run-ctrl-c-quits-without-update
  (let [seen (atom [])
        app {:init {}
             :update (fn [state msg] (swap! seen conj msg) [state nil])
             :view (fn [_] "x")
             :render-fn (fn [_] nil)
             :screen false
             :read-key-fn (scripted [:ctrl-c])}
        [_ event] (tui/run app)]
    (is (= :ctrl-c event))
    (is (= [] @seen))))

(deftest test-run-resize-rerenders-without-update
  (let [seen (atom [])
        frames (atom [])
        app {:init {}
             :update (fn [state msg] (swap! seen conj msg) [state :quit])
             :view (fn [_] "x")
             :render-fn (fn [s] (swap! frames conj s))
             :screen false
             :read-key-fn (scripted [:resize "q"])}]
    (tui/run app)
    (is (= ["q"] @seen))
    (is (= 2 (count @frames)))))

(deftest test-run-injects-tui-size
  (let [sizes (atom [])
        app {:init {}
             :update (fn [state _] [state :quit])
             :view (fn [state] (swap! sizes conj (:tui/size state)) "x")
             :render-fn (fn [_] nil)
             :screen false
             :read-key-fn (scripted ["q"])}]
    (tui/run app)
    (is (= [[80 24]] @sizes))))

(def projects
  [{:name "tiny-cli"} {:name "tiny-tui"} {:name "lgx"}])

(defn select-opts [script frames]
  {:title "Choose project"
   :items projects
   :item->text :name
   :read-key-fn (scripted script)
   :render-fn (fn [s] (swap! frames conj s))
   :screen false})

(deftest test-select-picks-item
  (is (= {:type :select
          :item {:name "tiny-tui"}
          :index 1}
         (tui/select (select-opts [:down :enter] (atom []))))))

(deftest test-select-cancel
  (is (= {:type :cancel} (tui/select (select-opts ["q"] (atom [])))))
  (is (= {:type :cancel} (tui/select (select-opts [:esc] (atom [])))))
  (is (= {:type :cancel} (tui/select (select-opts [:ctrl-c] (atom [])))))
  ;; EOF also cancels
  (is (= {:type :cancel} (tui/select (select-opts [] (atom []))))))

(defn string-opts [opts]
  (merge {:items ["a" "b" "c"]
          :item->text identity
          :render-fn (fn [_] nil)
          :screen false}
         opts))

(deftest test-select-cursor-item
  (testing ":cursor-item starts the cursor on that row"
    (is (= {:type :select
            :item "c"
            :index 2}
           (tui/select (string-opts {:cursor-item "c"
                                     :read-key-fn (scripted [:enter])})))))
  (testing "an unknown :cursor-item falls back to the top"
    (is (= {:type :select
            :item "a"
            :index 0}
           (tui/select (string-opts {:cursor-item "z"
                                     :read-key-fn (scripted [:enter])})))))
  (testing "no :cursor-item starts at the top"
    (is (= {:type :select
            :item "a"
            :index 0}
           (tui/select (string-opts {:read-key-fn (scripted [:enter])}))))))

(deftest test-select-returns-action
  (testing "a :returns? action exits select with its event even when :on-action is set"
    (is (= {:type :action
            :action :new
            :item "a"
            :index 0}
           (tui/select (string-opts
                         {:actions [{:id :new
                                     :key "c"
                                     :label "create"
                                     :returns? true}]
                          :on-action (fn [_] {:status "should not run"})
                          :read-key-fn (scripted ["c"])})))))
  (testing "without :returns?, :on-action handles the action and keeps looping"
    (let [ran (atom false)]
      (tui/select (string-opts
                    {:actions [{:id :new
                                :key "c"
                                :label "create"}]
                     :on-action (fn [_] (reset! ran true) {:status "x"})
                     :read-key-fn (scripted ["c"])}))
      (is (= true @ran)))))

(deftest test-select-initial-status
  (testing "a seed :status shows on the first frame, before any key"
    (let [frames (atom [])]
      (tui/select (string-opts {:status "seeded status"
                                :read-key-fn (scripted [:enter])
                                :render-fn (fn [s] (swap! frames conj s))}))
      (is (some (fn [f] (re-find #"seeded status" f)) @frames)))))

(defn filter-opts [script frames extra]
  (merge {:title "Projects"
          :items projects
          :item->text :name
          :filterable? true
          :read-key-fn (scripted script)
          :render-fn (fn [s] (swap! frames conj s))
          :screen false}
         extra))

(deftest test-select-filterable-narrows-and-selects
  ;; typing "tui" narrows to tiny-tui; enter selects it with its original index
  (is (= {:type :select
          :item {:name "tiny-tui"}
          :index 1}
         (tui/select (filter-opts ["t" "u" "i" :enter] (atom []) {})))))

(deftest test-select-filterable-q-types-not-quits
  ;; "q" narrows to the only item containing it, rather than cancelling
  (let [items [{:name "alpha"} {:name "sqlite"} {:name "beta"}]]
    (is (= {:type :select
            :item {:name "sqlite"}
            :index 1}
           (tui/select (filter-opts ["q" :enter] (atom []) {:items items}))))))

(deftest test-select-filterable-custom-filter-fn
  ;; an exact-match :filter-fn overrides the default substring match
  (is (= {:type :select
          :item {:name "lgx"}
          :index 2}
         (tui/select (filter-opts ["l" "g" "x" :enter] (atom [])
                                  {:filter-fn (fn [q item] (= q (:name item)))})))))

(def oa-projects [{:name "tiny-cli"} {:name "tiny-tui"} {:name "lgx"}])

(defn del-handler [calls items]
  ;; caller's (impure) handler: drop the acted-on item, report a status
  (fn [ev]
    (swap! calls conj ev)
    (swap! items (fn [xs] (vec (remove (fn [x] (= x (:item ev))) xs))))
    {:items @items
     :status (str "Removed " (:name (:item ev)))}))

(defn oa-opts [script frames items handler actions]
  {:title "Deps"
   :items @items
   :item->text :name
   :actions actions
   :on-action handler
   :read-key-fn (scripted script)
   :render-fn (fn [s] (swap! frames conj s))
   :screen false})

(deftest test-on-action-continues-loop-and-updates
  (let [frames (atom [])
        calls (atom [])
        items (atom oa-projects)]
    ;; delete the current item, then quit — the delete does NOT exit the loop
    (is (= {:type :cancel}
           (tui/select (oa-opts ["d" "q"] frames items (del-handler calls items)
                                [{:id :delete
                                  :key "d"
                                  :label "delete"}]))))
    (is (= 1 (count @calls)))
    (is (= :delete (:action (first @calls))))
    (is (= {:name "tiny-cli"} (:item (first @calls))))
    (is (= [{:name "tiny-tui"} {:name "lgx"}] @items))))

(deftest test-on-action-status-shows-then-clears
  (let [frames (atom [])
        calls (atom [])
        items (atom oa-projects)]
    (tui/select (oa-opts ["d" :down "q"] frames items (del-handler calls items)
                         [{:id :delete
                           :key "d"
                           :label "delete"}]))
    ;; the status appears in the frame right after the action ...
    (is (some (fn [f] (string/includes? f "Removed tiny-cli")) @frames))
    ;; ... and is gone from the frame rendered after the next key
    (is (not (string/includes? (last @frames) "Removed tiny-cli")))))

(deftest test-on-action-receives-confirmed-event
  (let [frames (atom [])
        calls (atom [])
        items (atom oa-projects)
        action {:id :delete
                :key "d"
                :label "delete"
                :destructive? true
                :confirm-message "Sure?"}]
    ;; destructive -> confirm popup -> "y" routes the confirmed event to on-action
    (tui/select (oa-opts ["d" "y" "q"] frames items (del-handler calls items) [action]))
    (is (= 1 (count @calls)))
    (is (= true (:confirmed? (first @calls))))
    (is (= [{:name "tiny-tui"} {:name "lgx"}] @items))))

(deftest test-action-without-handler-still-exits
  ;; regression: with no :on-action, an action returns and exits as before
  (is (= {:type :action
          :action :delete
          :item {:name "tiny-cli"}
          :index 0}
         (tui/select {:title "Deps"
                      :items oa-projects
                      :item->text :name
                      :actions [{:id :delete
                                 :key "d"
                                 :label "delete"}]
                      :read-key-fn (scripted ["d"])
                      :render-fn (fn [_] nil)
                      :screen false}))))

(deftest test-select-frame
  (let [frames (atom [])]
    (tui/select (select-opts ["q"] frames))
    (is (= (layout/vstack
             (style/bold "Choose project")
             ""
             (tlist/view (tlist/create {:items projects
                                        :item->text :name}))
             ""
             (help/view [{:key "↑/↓"
                          :label "navigate"}
                         {:key "enter"
                          :label "select"}
                         {:key "q"
                          :label "quit"}]))
           (first @frames)))))

(deftest test-select-without-title
  (let [frames (atom [])]
    (tui/select (assoc (select-opts ["q"] frames) :title nil))
    (is (= (layout/vstack
             (tlist/view (tlist/create {:items projects
                                        :item->text :name}))
             ""
             (help/view [{:key "↑/↓"
                          :label "navigate"}
                         {:key "enter"
                          :label "select"}
                         {:key "q"
                          :label "quit"}]))
           (first @frames)))))

(def delete-action
  {:id :delete
   :key "d"
   :label "delete"
   :destructive? true})

(deftest test-select-frame-includes-action-help
  (let [frames (atom [])
        opts {:items projects
              :item->text :name
              :actions [delete-action]}]
    (tui/select (merge (select-opts ["q"] frames) opts))
    (is (= (layout/vstack
             (style/bold "Choose project")
             ""
             (tlist/view (tlist/create opts))
             ""
             (help/view (tlist/bindings (tlist/create opts))))
           (first @frames)))))

(def confirmed-delete-action
  {:id :delete
   :key "d"
   :label "delete"
   :destructive? true
   :confirm-title "Delete project?"
   :confirm-message (fn [item] (str "Delete " (:name item) "?"))})

(def open-action
  {:id :open
   :key "o"
   :label "open"})

(defn gated-opts [script frames]
  (assoc (select-opts script frames)
         :actions [open-action confirmed-delete-action]))

(deftest test-destructive-action-confirmed
  (is (= {:type :action
          :action :delete
          :item {:name "tiny-cli"}
          :index 0
          :destructive? true
          :confirmed? true}
         (tui/select (gated-opts ["d" "y"] (atom []))))))

(deftest test-destructive-action-cancelled-returns-to-list
  ;; "n" dismisses the confirmation; the next enter selects the item the
  ;; list cursor was on all along
  (is (= {:type :select
          :item {:name "tiny-cli"}
          :index 0}
         (tui/select (gated-opts ["d" "n" :enter] (atom []))))))

(deftest test-confirm-mode-captures-keys
  ;; :down moves the confirm cursor (to "cancel"), not the list cursor;
  ;; enter then cancels, and the final enter selects the unchanged item 0
  (is (= {:type :select
          :item {:name "tiny-cli"}
          :index 0}
         (tui/select (gated-opts ["d" :down :enter :enter] (atom []))))))

(deftest test-non-destructive-action-skips-confirmation
  (is (= {:type :action
          :action :open
          :item {:name "tiny-cli"}
          :index 0}
         (tui/select (gated-opts ["o"] (atom []))))))

(deftest test-confirm-mode-frame
  (let [frames (atom [])]
    (tui/select (gated-opts ["d" "y"] frames))
    (is (= (layout/vstack
             (tconfirm/view (tconfirm/create {:title "Delete project?"
                                              :message "Delete tiny-cli?"
                                              :confirm-label "delete"
                                              :cancel-label "cancel"}))
             ""
             (help/view [{:key "↑/↓"
                          :label "navigate"}
                         {:key "enter"
                          :label "select"}
                         {:key "esc"
                          :label "cancel"}]))
           (last @frames)))))

(defn confirm-opts [script frames]
  {:title "Delete project?"
   :message "This cannot be undone."
   :confirm-label "delete"
   :cancel-label "cancel"
   :read-key-fn (scripted script)
   :render-fn (fn [s] (swap! frames conj s))
   :screen false})

(deftest test-confirm-returns-boolean
  ;; cursor starts on the confirm entry
  (is (= true (tui/confirm (confirm-opts [:enter] (atom [])))))
  (is (= false (tui/confirm (confirm-opts [:down :enter] (atom [])))))
  (is (= true (tui/confirm (confirm-opts ["y"] (atom [])))))
  (is (= false (tui/confirm (confirm-opts ["n"] (atom [])))))
  (is (= false (tui/confirm (confirm-opts [:esc] (atom [])))))
  (is (= false (tui/confirm (confirm-opts [:ctrl-c] (atom [])))))
  ;; EOF cancels
  (is (= false (tui/confirm (confirm-opts [] (atom []))))))

(deftest test-confirm-frame
  (let [frames (atom [])]
    (tui/confirm (confirm-opts ["n"] frames))
    (is (= (layout/vstack
             (tconfirm/view (tconfirm/create {:title "Delete project?"
                                              :message "This cannot be undone."
                                              :confirm-label "delete"
                                              :cancel-label "cancel"}))
             ""
             (help/view [{:key "↑/↓"
                          :label "navigate"}
                         {:key "enter"
                          :label "select"}
                         {:key "esc"
                          :label "cancel"}]))
           (first @frames)))))

(defn input-opts [script frames extra]
  (merge {:title "Your name"
          :read-key-fn (scripted script)
          :render-fn (fn [s] (swap! frames conj s))
          :screen false}
         extra))

(deftest test-input-submits-typed-text
  (is (= "hi" (tui/input (input-opts ["h" "i" :enter] (atom []) {})))))

(deftest test-input-cancel-returns-nil
  (is (nil? (tui/input (input-opts [:esc] (atom []) {}))))
  (is (nil? (tui/input (input-opts [:ctrl-c] (atom []) {}))))
  ;; EOF also cancels
  (is (nil? (tui/input (input-opts [] (atom []) {})))))

(deftest test-input-validate-blocks-then-submits
  ;; enter on empty is rejected by :validate; typing then enter submits
  (let [validate (fn [t] (when (empty? t) "required"))]
    (is (= "x" (tui/input (input-opts [:enter "x" :enter]
                                      (atom [])
                                      {:validate validate}))))))

(deftest test-run-eof-terminates
  (let [app {:init {:a 1}
             :update (fn [state _] [state nil])
             :view (fn [_] "x")
             :render-fn (fn [_] nil)
             :screen false
             :read-key-fn (scripted [])}
        [state event] (tui/run app)]
    (is (= 1 (:a state)))
    (is (nil? event))))

(def ms-items [{:name "a"} {:name "b"} {:name "c"}])

(defn ms-opts [script extra]
  (merge {:title "Pick"
          :items ms-items
          :item->text :name
          :read-key-fn (scripted script)
          :render-fn (fn [_] nil)
          :screen false}
         extra))

(deftest test-multi-select-returns-chosen-items
  ;; toggle row 0, down, toggle row 1, submit -> [a b] in index order
  (is (= [{:name "a"} {:name "b"}]
         (tui/multi-select (ms-opts [" " :down " " :enter] {})))))

(deftest test-multi-select-empty-submit-returns-empty-vector
  (is (= [] (tui/multi-select (ms-opts [:enter] {})))))

(deftest test-multi-select-cancel-returns-nil
  (is (nil? (tui/multi-select (ms-opts [:esc] {}))))
  (is (nil? (tui/multi-select (ms-opts [:ctrl-c] {})))))

(deftest test-select-multi-emits-submit-event
  ;; the underlying event shape via tui/select with :multi? true
  (is (= {:type :submit
          :items [{:name "a"}]
          :indices [0]}
         (tui/select (ms-opts [" " :enter] {:multi? true})))))
