(ns tiny-tui.core-test
  (:require [clojure.test :refer :all]
            [tiny-tui.confirm :as tconfirm]
            [tiny-tui.core :as tui]
            [tiny-tui.help :as help]
            [tiny-tui.layout :as layout]
            [tiny-tui.list :as tlist]
            [tiny-tui.style :as style]))

(defn scripted
  "Read-fn that returns the scripted messages one by one, then nil (EOF)."
  [msgs]
  (let [q (atom (seq msgs))]
    (fn []
      (let [m (first @q)]
        (swap! q rest)
        m))))

(defn counter-app [frames]
  {:init {:count 0}
   :update (fn [state msg]
             (case msg
               :up [(update state :count inc) nil]
               :down [(update state :count dec) nil]
               "q" [state :quit]
               [state nil]))
   :view (fn [state] (str "Count: " (:count state)))
   :render-fn (fn [s] (swap! frames conj s))
   :screen false})

(deftest test-run-counter
  (let [frames (atom [])
        [state event] (tui/run (assoc (counter-app frames)
                                      :read-key-fn (scripted [:up :up :down "q"])))]
    (is (= 1 (:count state)))
    (is (= :quit event))
    ;; one frame per loop iteration: initial + after each of the 3 moves
    (is (= 4 (count @frames)))
    (is (= "Count: 1" (last @frames)))))

(deftest test-run-ctrl-c-quits-without-update
  (let [seen (atom [])
        app {:init {}
             :update (fn [state msg] (swap! seen conj msg) [state nil])
             :view (fn [_] "x")
             :render-fn (fn [_] nil)
             :screen false
             :read-key-fn (scripted [:ctrl-c])}
        [_ event] (tui/run app)]
    (is (= :ctrl-c event))
    (is (= [] @seen))))

(deftest test-run-resize-rerenders-without-update
  (let [seen (atom [])
        frames (atom [])
        app {:init {}
             :update (fn [state msg] (swap! seen conj msg) [state :quit])
             :view (fn [_] "x")
             :render-fn (fn [s] (swap! frames conj s))
             :screen false
             :read-key-fn (scripted [:resize "q"])}]
    (tui/run app)
    (is (= ["q"] @seen))
    (is (= 2 (count @frames)))))

(deftest test-run-injects-tui-size
  (let [sizes (atom [])
        app {:init {}
             :update (fn [state _] [state :quit])
             :view (fn [state] (swap! sizes conj (:tui/size state)) "x")
             :render-fn (fn [_] nil)
             :screen false
             :read-key-fn (scripted ["q"])}]
    (tui/run app)
    (is (= [[80 24]] @sizes))))

(def projects
  [{:name "tiny-cli"} {:name "tiny-tui"} {:name "lgx"}])

(defn select-opts [script frames]
  {:title "Choose project"
   :items projects
   :item->text :name
   :read-key-fn (scripted script)
   :render-fn (fn [s] (swap! frames conj s))
   :screen false})

(deftest test-select-picks-item
  (is (= {:type :select
          :item {:name "tiny-tui"}
          :index 1}
         (tui/select (select-opts [:down :enter] (atom []))))))

(deftest test-select-cancel
  (is (= {:type :cancel} (tui/select (select-opts ["q"] (atom [])))))
  (is (= {:type :cancel} (tui/select (select-opts [:esc] (atom [])))))
  (is (= {:type :cancel} (tui/select (select-opts [:ctrl-c] (atom [])))))
  ;; EOF also cancels
  (is (= {:type :cancel} (tui/select (select-opts [] (atom []))))))

(deftest test-select-frame
  (let [frames (atom [])]
    (tui/select (select-opts ["q"] frames))
    (is (= (layout/vstack
             (style/bold "Choose project")
             ""
             (tlist/view (tlist/create {:items projects
                                        :item->text :name}))
             ""
             (help/view [{:key "↑/↓"
                          :label "navigate"}
                         {:key "enter"
                          :label "select"}
                         {:key "q"
                          :label "quit"}]))
           (first @frames)))))

(deftest test-select-without-title
  (let [frames (atom [])]
    (tui/select (assoc (select-opts ["q"] frames) :title nil))
    (is (= (layout/vstack
             (tlist/view (tlist/create {:items projects
                                        :item->text :name}))
             ""
             (help/view [{:key "↑/↓"
                          :label "navigate"}
                         {:key "enter"
                          :label "select"}
                         {:key "q"
                          :label "quit"}]))
           (first @frames)))))

(def delete-action
  {:id :delete
   :key "d"
   :label "delete"
   :destructive? true})

(deftest test-select-frame-includes-action-help
  (let [frames (atom [])
        opts {:items projects
              :item->text :name
              :actions [delete-action]}]
    (tui/select (merge (select-opts ["q"] frames) opts))
    (is (= (layout/vstack
             (style/bold "Choose project")
             ""
             (tlist/view (tlist/create opts))
             ""
             (help/view (tlist/bindings (tlist/create opts))))
           (first @frames)))))

(def confirmed-delete-action
  {:id :delete
   :key "d"
   :label "delete"
   :destructive? true
   :confirm-title "Delete project?"
   :confirm-message (fn [item] (str "Delete " (:name item) "?"))})

(def open-action
  {:id :open
   :key "o"
   :label "open"})

(defn gated-opts [script frames]
  (assoc (select-opts script frames)
         :actions [open-action confirmed-delete-action]))

(deftest test-destructive-action-confirmed
  (is (= {:type :action
          :action :delete
          :item {:name "tiny-cli"}
          :index 0
          :destructive? true
          :confirmed? true}
         (tui/select (gated-opts ["d" "y"] (atom []))))))

(deftest test-destructive-action-cancelled-returns-to-list
  ;; "n" dismisses the confirmation; the next enter selects the item the
  ;; list cursor was on all along
  (is (= {:type :select
          :item {:name "tiny-cli"}
          :index 0}
         (tui/select (gated-opts ["d" "n" :enter] (atom []))))))

(deftest test-confirm-mode-captures-keys
  ;; :down moves the confirm cursor (to "cancel"), not the list cursor;
  ;; enter then cancels, and the final enter selects the unchanged item 0
  (is (= {:type :select
          :item {:name "tiny-cli"}
          :index 0}
         (tui/select (gated-opts ["d" :down :enter :enter] (atom []))))))

(deftest test-non-destructive-action-skips-confirmation
  (is (= {:type :action
          :action :open
          :item {:name "tiny-cli"}
          :index 0}
         (tui/select (gated-opts ["o"] (atom []))))))

(deftest test-confirm-mode-frame
  (let [frames (atom [])]
    (tui/select (gated-opts ["d" "y"] frames))
    (is (= (layout/vstack
             (tconfirm/view (tconfirm/create {:title "Delete project?"
                                              :message "Delete tiny-cli?"
                                              :confirm-label "delete"
                                              :cancel-label "cancel"}))
             ""
             (help/view [{:key "↑/↓"
                          :label "navigate"}
                         {:key "enter"
                          :label "select"}
                         {:key "esc"
                          :label "cancel"}]))
           (last @frames)))))

(defn confirm-opts [script frames]
  {:title "Delete project?"
   :message "This cannot be undone."
   :confirm-label "delete"
   :cancel-label "cancel"
   :read-key-fn (scripted script)
   :render-fn (fn [s] (swap! frames conj s))
   :screen false})

(deftest test-confirm-returns-boolean
  ;; cursor starts on the confirm entry
  (is (= true (tui/confirm (confirm-opts [:enter] (atom [])))))
  (is (= false (tui/confirm (confirm-opts [:down :enter] (atom [])))))
  (is (= true (tui/confirm (confirm-opts ["y"] (atom [])))))
  (is (= false (tui/confirm (confirm-opts ["n"] (atom [])))))
  (is (= false (tui/confirm (confirm-opts [:esc] (atom [])))))
  (is (= false (tui/confirm (confirm-opts [:ctrl-c] (atom [])))))
  ;; EOF cancels
  (is (= false (tui/confirm (confirm-opts [] (atom []))))))

(deftest test-confirm-frame
  (let [frames (atom [])]
    (tui/confirm (confirm-opts ["n"] frames))
    (is (= (layout/vstack
             (tconfirm/view (tconfirm/create {:title "Delete project?"
                                              :message "This cannot be undone."
                                              :confirm-label "delete"
                                              :cancel-label "cancel"}))
             ""
             (help/view [{:key "↑/↓"
                          :label "navigate"}
                         {:key "enter"
                          :label "select"}
                         {:key "esc"
                          :label "cancel"}]))
           (first @frames)))))

(deftest test-run-eof-terminates
  (let [app {:init {:a 1}
             :update (fn [state _] [state nil])
             :view (fn [_] "x")
             :render-fn (fn [_] nil)
             :screen false
             :read-key-fn (scripted [])}
        [state event] (tui/run app)]
    (is (= 1 (:a state)))
    (is (nil? event))))
