;; Stage 4 demo: pick an item with tui/select.
;;
;; Run from the repo root: LG_SOURCE_PATHS=src lg examples/select_project.lg

(ns examples.select-project
  (:require [tiny-tui.core :as tui]))

(def projects
  [{:id 1 :name "tiny-cli"}
   {:id 2 :name "tiny-tui"}
   {:id 3 :name "lgx"}])

(defn -main []
  (let [res (tui/select {:title "Select project"
                         :items [{:name "tiny-cli"} {:name "tiny-tui"} {:name "lgx"}]
                         :item->text :name})]
    (case (:type res)
      :select (println "Selected" (:name (:item res)))
      :cancel nil)))
  
(when-not *compiling-aot* (-main))
