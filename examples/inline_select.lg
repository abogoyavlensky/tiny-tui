;; Inline demo: pick an item without leaving the current screen.
;;
;; With :inline? true, tui/select renders in place at the cursor (gum/fzf
;; style) and erases itself on exit, so the println below lands right where
;; the list was — no alternate screen, no clearing the scrollback.
;;
;; Run from the repo root: lgx run examples/inline_select.lg

(ns examples.inline-select
  (:require [tiny-tui.core :as tui]))

(def flavors
  [{:id 1 :name "vanilla"}
   {:id 2 :name "chocolate"}
   {:id 3 :name "strawberry"}
   {:id 4 :name "pistachio"}
   {:id 5 :name "mango"}])

(defn -main []
  (println "Pick a flavor (inline):")
  (let [result (tui/select {:title "Flavors"
                            :items flavors
                            :item->text :name
                            :inline? true})]
    (case (:type result)
      :select (println "Scooped:" (:name (:item result)))
      :cancel (println "No scoops today."))))

(when-not *compiling-aot* (-main))
