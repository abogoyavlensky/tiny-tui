;; tiny-tui.layout — pure string layout helpers. All measurements use
;; style/visible-width so styled text lays out correctly.

(ns tiny-tui.layout
  (:require [string]
            [tiny-tui.style :as style]))

(defn lines
  [s]
  (let [ls (string/split s "\n")]
    (if (empty? ls) [""] (vec ls))))

(defn vstack
  "Stack blocks vertically, skipping nils. Blocks may be multi-line."
  [& blocks]
  (string/join "\n" (remove nil? blocks)))

(defn hstack
  "Join strings on one line, with `sep` (default two spaces) between them."
  ([xs] (hstack "  " xs))
  ([sep xs] (string/join sep xs)))

(defn pad
  "Right-pad `s` with spaces to visible width `w`."
  [s w]
  (let [n (- w (style/visible-width s))]
    (if (pos? n)
      (str s (apply str (repeat n " ")))
      s)))

(defn- content-count
  ;; Number of leading cells to keep: through the last non-empty one. Trailing
  ;; blanks are dropped so a row missing later columns ends without a stray
  ;; separator (which would show as trailing whitespace under a selected row).
  [row]
  (loop [i (count row)]
    (if (and (pos? i) (= "" (nth row (dec i))))
      (recur (dec i))
      i)))

(defn columns
  "Align rows of cells into a table: each column is right-padded to the max
   visible width of its cells (so styled cells line up), the last cell of a
   row is left unpadded, and cells are joined with `sep` (default two spaces).
   Returns a vector of row strings. Ragged rows are tolerated: missing cells
   are blank, and trailing blanks are trimmed (a middle blank still pads, to
   keep later columns aligned). Build the aligned lines once, then use them as
   a list's :item->text; or vstack them for a static table."
  ([rows] (columns "  " rows))
  ([sep rows]
   (if (empty? rows)
     []
     (let [ncols (apply max (map count rows))
           norm (map (fn [row] (take ncols (concat row (repeat "")))) rows)
           widths (map (fn [c]
                         (apply max 0 (map (fn [row] (style/visible-width (nth row c)))
                                           norm)))
                       (range ncols))]
       (vec (map (fn [row]
                   (let [kept (take (content-count row) row)
                         last-i (dec (count kept))]
                     (string/join sep
                                  (map-indexed (fn [c cell]
                                                 (if (= c last-i)
                                                   cell
                                                   (pad cell (nth widths c))))
                                               kept))))
                 norm))))))

(defn box
  "Draw a box around (possibly multi-line, possibly styled) `content`,
   sized to the widest visible line with one space of inner padding."
  [content]
  (let [ls (lines content)
        w (apply max (map style/visible-width ls))
        bar (apply str (repeat (+ 2 w) "─"))]
    (string/join "\n"
                 (concat [(str "┌" bar "┐")]
                         (map #(str "│ " (pad % w) " │") ls)
                         [(str "└" bar "┘")]))))
