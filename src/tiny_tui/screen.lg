;; tiny-tui.screen — terminal ownership: entering/leaving raw interactive
;; mode safely, and writing full frames.
;;
;; This is one of the two namespaces allowed to touch the terminal (the
;; other is tiny-tui.key). Everything else in tiny-tui is pure.
;;
;; Escape codes are built with (char 27) rather than written as literal
;; control characters, so the source stays readable and editing tools can't
;; corrupt it.

(ns tiny-tui.screen
  (:require [string]
            [term]))

(def ^:private ESC (str (char 27)))
(def ^:private home (str ESC "[H"))
(def ^:private clear-eol (str ESC "[K"))
(def ^:private clear-below (str ESC "[J"))

(defn frame-str
  "Build the ANSI string for one full-frame render of view string `s`:
   cursor home, each line followed by clear-to-end-of-line, lines joined
   with \\r\\n (raw mode needs the \\r), then clear everything below.
   Clearing per line instead of wiping the whole screen avoids flicker."
  [s]
  (let [lines (string/split s "\n")
        lines (if (empty? lines) [""] lines)]
    (str home
         (string/join (str clear-eol "\r\n") lines)
         clear-eol
         clear-below)))

(defn inline-frame-str
  "Build the ANSI string for one in-place (inline) render of view string
   `s`. Like frame-str, but instead of homing to the top of the alternate
   screen it renders wherever the cursor sits and, crucially, returns the
   cursor to the frame's own top-left when done: carriage-return to column
   0, each line + clear-to-end-of-line joined with \\r\\n, clear everything
   below (erases leftover rows when a frame is shorter than the last one),
   then move up height-1 rows and carriage-return.

   Because every frame ends at its own top-left, each frame is entirely
   self-contained — no rendered-height state is carried between frames, and
   erasing the widget on exit is a single clear-below from that resting
   position."
  [s]
  (let [lines (string/split s "\n")
        lines (if (empty? lines) [""] lines)
        height (count lines)]
    (str "\r"
         (string/join (str clear-eol "\r\n") lines)
         clear-eol
         clear-below
         (if (> height 1) (str ESC "[" (dec height) "A") "")
         "\r")))

(defn shutdown!
  "Give the terminal back: restore style, cursor, main screen and cooked
   mode. Safe to call even if init! only partially succeeded."
  []
  (term/reset-style)
  (term/show-cursor)
  (term/main-screen)
  (term/flush)
  (term/restore-mode!))

(defn init!
  "Take over the terminal: raw mode, alternate screen, hidden cursor.
   Throws when stdin/stdout is not a terminal (term/size returns nil).
   If setup fails after raw mode was enabled, the terminal is restored
   before the error propagates."
  []
  (when (nil? (term/size))
    (throw (ex-info "tiny-tui requires a terminal (stdin/stdout is not a tty)" {})))
  (term/raw-mode!)
  (try
    (term/alternate-screen)
    (term/hide-cursor)
    (term/clear)
    (term/flush)
    (catch e
           (shutdown!)
      (throw e))))

(defn render!
  "Write one full frame built from view string `s`."
  [s]
  (term/write (frame-str s))
  (term/flush))

(defn clear!
  []
  (term/clear)
  (term/flush))

(defn with-screen*
  "Run thunk `f` with the terminal in TUI mode; shut the terminal down
   afterwards whether `f` returned or threw, then return/rethrow.
   Deliberately avoids try/finally: in let-go a try without catch returns
   the thrown value instead of propagating it, and a catch that rethrows
   skips the finally — either way cleanup or the error would be lost."
  [f]
  (init!)
  (let [result (try [:ok (f)] (catch e [:err e]))]
    (shutdown!)
    (if (= :ok (first result))
      (second result)
      (throw (second result)))))

(defmacro with-screen
  "Run `body` with the terminal in TUI mode, guaranteeing cleanup even when
   an exception escapes."
  [& body]
  (list 'tiny-tui.screen/with-screen* (list 'fn [] (cons 'do body))))

;; --- Inline mode ---------------------------------------------------------
;; Render in place at the cursor (gum/fzf style) instead of taking over the
;; alternate screen, erasing the widget on exit. Siblings of the functions
;; above; ordered so nothing forward-references (shutdown before init, both
;; before with-inline-screen*).

(defn render-inline!
  "Write one full frame built from view string `s`, rendered in place."
  [s]
  (term/write (inline-frame-str s))
  (term/flush))

(defn shutdown-inline!
  "Give the terminal back after inline mode: erase the widget — the cursor
   rests at its top-left, so a clear-below wipes the whole thing — then
   restore style, cursor and cooked mode. Never touches the main/alternate
   screen (inline mode never left the main screen). Safe to call even if
   init-inline! only partially succeeded."
  []
  (term/write (str clear-below "\r"))
  (term/reset-style)
  (term/show-cursor)
  (term/flush)
  (term/restore-mode!))

(defn init-inline!
  "Take over the terminal for inline mode: raw mode and a hidden cursor,
   rendering in place — no alternate screen, no clear. Throws when
   stdin/stdout is not a terminal (term/size returns nil). If setup fails
   after raw mode was enabled, the terminal is restored before the error
   propagates."
  []
  (when (nil? (term/size))
    (throw (ex-info "tiny-tui requires a terminal (stdin/stdout is not a tty)" {})))
  (term/raw-mode!)
  (try
    (term/hide-cursor)
    (term/flush)
    (catch e
           (shutdown-inline!)
      (throw e))))

(defn with-inline-screen*
  "Run thunk `f` with the terminal in inline TUI mode; shut the terminal
   down afterwards whether `f` returned or threw, then return/rethrow. Uses
   the same capture/cleanup/rethrow pattern as with-screen* to dodge the
   let-go try/finally quirks."
  [f]
  (init-inline!)
  (let [result (try [:ok (f)] (catch e [:err e]))]
    (shutdown-inline!)
    (if (= :ok (first result))
      (second result)
      (throw (second result)))))

(defmacro with-inline-screen
  "Run `body` with the terminal in inline TUI mode, guaranteeing cleanup
   even when an exception escapes."
  [& body]
  (list 'tiny-tui.screen/with-inline-screen* (list 'fn [] (cons 'do body))))
