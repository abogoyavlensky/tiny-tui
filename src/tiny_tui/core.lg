;; tiny-tui.core — the public API.
;;
;; run: the minimal program loop. An app is three things:
;;   :init   initial state (a map)
;;   :update (fn [state msg] [new-state event]) — nil event keeps looping,
;;           any non-nil event stops the loop
;;   :view   (fn [state] string)
;;
;; run returns [final-state event]. It handles :ctrl-c itself (returns
;; event :ctrl-c without consulting :update) and treats :resize as a plain
;; redraw. Terminal size is injected as :tui/size before every view call.
;;
;; Testing hooks (all optional): :read-key-fn, :render-fn, :screen false —
;; they let whole flows run headlessly with scripted keys.

(ns tiny-tui.core
  (:require [term]
            [tiny-tui.confirm :as tconfirm]
            [tiny-tui.help :as help]
            [tiny-tui.key :as key]
            [tiny-tui.layout :as layout]
            [tiny-tui.list :as tlist]
            [tiny-tui.screen :as screen]
            [tiny-tui.style :as style]))

(defn- terminal-size []
  ;; term/size is nil on a plain pipe and can report [0 0] on an
  ;; unconfigured pty — both are unusable for layout.
  (let [size (term/size)]
    (if (and size (pos? (first size)) (pos? (second size)))
      size
      [80 24])))

(defn- run-loop [opts]
  (let [update-fn (:update opts)
        view (:view opts)
        read-key-fn (or (:read-key-fn opts) key/read)
        render-fn (or (:render-fn opts) screen/render!)]
    (loop [state (:init opts)]
      (let [state (assoc state :tui/size (terminal-size))]
        (render-fn (view state))
        (let [msg (read-key-fn)]
          (cond
            (nil? msg) [state nil]
            (= msg :ctrl-c) [state :ctrl-c]
            (= msg :resize) (recur state)
            :else (let [result (update-fn state msg)
                        next-state (first result)
                        event (second result)]
                    (if (nil? event)
                      (recur next-state)
                      [next-state event]))))))))

(defn run
  "Run a TUI program (see namespace docstring). Returns [final-state event]."
  [opts]
  (if (false? (:screen opts))
    (run-loop opts)
    (screen/with-screen
      (run-loop opts))))

(def ^:private confirm-bindings
  [{:key "↑/↓"
    :label "navigate"}
   {:key "enter"
    :label "select"}
   {:key "esc"
    :label "cancel"}])

(defn- confirm-view [confirm-state]
  (layout/vstack
    (tconfirm/view confirm-state)
    ""
    (help/view confirm-bindings)))

(defn- select-view [opts state]
  (if (= :confirm (:mode state))
    (confirm-view (:confirm state))
    (apply layout/vstack
           (concat
             (when (:title opts)
               [(style/bold (:title opts)) ""])
             [(tlist/view (:list state) {:width (first (:tui/size state))})
              ""
              (help/view (tlist/bindings (:list state)))]))))

(defn- action-config [opts event]
  (first (filter (fn [a] (= (:action event) (:id a))) (:actions opts))))

(defn- needs-confirm? [action]
  (boolean (or (:confirm? action) (:destructive? action))))

(defn- confirm-for-action [action event]
  (let [m (:confirm-message action)]
    (tconfirm/create
      {:title (or (:confirm-title action) "Are you sure?")
       :message (cond
                  (nil? m) nil
                  (string? m) m
                  :else (m (:item event)))
       :confirm-label (or (:label action) "yes")
       :cancel-label "cancel"})))

(defn- select-update [opts state msg]
  (if (= :confirm (:mode state))
    ;; confirmation owns every key while open
    (let [r (tconfirm/update (:confirm state) msg)
          event (second r)]
      (cond
        (nil? event) [(assoc state :confirm (first r)) nil]
        (:value event) [state (assoc (:pending-action state) :confirmed? true)]
        :else [(assoc state :mode :list :confirm nil :pending-action nil) nil]))
    (let [r (tlist/update (:list state) msg)
          event (second r)
          state (assoc state :list (first r))
          action (when (= :action (:type event)) (action-config opts event))]
      (if (and action (needs-confirm? action))
        [(assoc state
                :mode :confirm
                :confirm (confirm-for-action action event)
                :pending-action event)
         nil]
        [state event]))))

(defn select
  "Show a navigable list and return the user's choice:
     {:type :select :item item :index n}                on enter
     {:type :action :action id :item item :index n
      :destructive? true (when set)}                    on an action key
     {:type :cancel}                                    on q / esc / Ctrl-C
   An action with :confirm? or :destructive? set first opens a yes/no
   confirmation (configured by its :confirm-title and :confirm-message —
   a string or a fn of the item); the accepted action event carries
   :confirmed? true.
   opts: :title, :items, :item->text, :actions (see tiny-tui.list/create),
   plus the run testing hooks (:read-key-fn :render-fn :screen)."
  [opts]
  (let [result (run {:init {:mode :list
                            :list (tlist/create opts)}
                     :update (fn [state msg] (select-update opts state msg))
                     :view (fn [state] (select-view opts state))
                     :read-key-fn (:read-key-fn opts)
                     :render-fn (:render-fn opts)
                     :screen (:screen opts)})
        event (second result)]
    (if (map? event)
      event
      {:type :cancel})))

(defn confirm
  "Ask a yes/no question and return a plain boolean. Cancelling (esc, q,
   Ctrl-C, end of input) returns false.
   opts: :title, :message, :confirm-label, :cancel-label (see
   tiny-tui.confirm/create), plus the run testing hooks."
  [opts]
  (let [result (run {:init {:confirm (tconfirm/create opts)}
                     :update (fn [state msg]
                               (let [r (tconfirm/update (:confirm state) msg)]
                                 [(assoc state :confirm (first r)) (second r)]))
                     :view (fn [state]
                             (layout/vstack
                               (tconfirm/view (:confirm state))
                               ""
                               (help/view confirm-bindings)))
                     :read-key-fn (:read-key-fn opts)
                     :render-fn (:render-fn opts)
                     :screen (:screen opts)})
        event (second result)]
    (if (map? event)
      (boolean (:value event))
      false)))
