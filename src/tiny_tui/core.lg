;; tiny-tui.core — the public API.
;;
;; run: the minimal program loop. An app is three things:
;;   :init   initial state (a map)
;;   :update (fn [state msg] [new-state event]) — nil event keeps looping,
;;           any non-nil event stops the loop
;;   :view   (fn [state] string)
;;
;; run returns [final-state event]. It handles :ctrl-c itself (returns
;; event :ctrl-c without consulting :update) and treats :resize as a plain
;; redraw. Terminal size is injected as :tui/size before every view call.
;;
;; :inline? true renders in place at the cursor (gum/fzf style) and erases
;; the widget on exit, instead of taking over the alternate screen — best
;; for small pickers that fit on screen.
;;
;; Testing hooks (all optional): :read-key-fn, :render-fn, :screen false —
;; they let whole flows run headlessly with scripted keys.

(ns tiny-tui.core
  (:require [term]
            [tiny-tui.confirm :as tconfirm]
            [tiny-tui.help :as help]
            [tiny-tui.input :as tinput]
            [tiny-tui.key :as key]
            [tiny-tui.layout :as layout]
            [tiny-tui.list :as tlist]
            [tiny-tui.screen :as screen]
            [tiny-tui.style :as style]))

(defn- terminal-size []
  ;; term/size is nil on a plain pipe and can report [0 0] on an
  ;; unconfigured pty — both are unusable for layout.
  (let [size (term/size)]
    (if (and size (pos? (first size)) (pos? (second size)))
      size
      [80 24])))

(defn- run-loop [opts]
  (let [update-fn (:update opts)
        view (:view opts)
        read-key-fn (or (:read-key-fn opts) key/read)
        render-fn (or (:render-fn opts)
                      (if (:inline? opts) screen/render-inline! screen/render!))]
    (loop [state (:init opts)]
      (let [state (assoc state :tui/size (terminal-size))]
        (render-fn (view state))
        (let [msg (read-key-fn)]
          (cond
            (nil? msg) [state nil]
            (= msg :ctrl-c) [state :ctrl-c]
            (= msg :resize) (recur state)
            :else (let [result (update-fn state msg)
                        next-state (first result)
                        event (second result)]
                    (if (nil? event)
                      (recur next-state)
                      [next-state event]))))))))

(defn run
  "Run a TUI program (see namespace docstring). Returns [final-state event]."
  [opts]
  (cond
    (false? (:screen opts)) (run-loop opts)
    (:inline? opts) (screen/with-inline-screen (run-loop opts))
    :else (screen/with-screen (run-loop opts))))

(def ^:private confirm-bindings
  [{:key "↑/↓"
    :label "navigate"}
   {:key "enter"
    :label "select"}
   {:key "esc"
    :label "cancel"}])

(defn- confirm-view [confirm-state]
  (layout/vstack
    (tconfirm/view confirm-state)
    ""
    (help/view confirm-bindings)))

(defn- list-height [opts state]
  ;; Rows available for the list block = terminal rows minus the chrome
  ;; around it: title + its blank (2) when a title is set, the blank and help
  ;; lines (2), and the status line + its blank (2) when a status is showing.
  ;; Clamped to at least one row for tiny/misreported terminals. The list's
  ;; own scroll indicator is reserved inside this budget by
  ;; tiny-tui.list/window, not counted here.
  (max 1 (- (second (:tui/size state))
            (+ (if (:title opts) 4 2)
               (if (:status state) 2 0)))))

(defn- select-view [opts state]
  (if (= :confirm (:mode state))
    (confirm-view (:confirm state))
    (apply layout/vstack
           (concat
             (when (:title opts)
               [(style/bold (:title opts)) ""])
             [(tlist/view (:list state) {:width (first (:tui/size state))
                                         :height (list-height opts state)})]
             ;; A transient status line from :on-action, styled by the caller.
             (when (:status state) ["" (:status state)])
             [""
              (help/view (tlist/bindings (:list state)))]))))

(defn- action-config [opts event]
  (first (filter (fn [a] (= (:action event) (:id a))) (:actions opts))))

(defn- needs-confirm? [action]
  (boolean (or (:confirm? action) (:destructive? action))))

(defn- confirm-for-action [action event]
  (let [m (:confirm-message action)]
    (tconfirm/create
      {:title (or (:confirm-title action) "Are you sure?")
       :message (cond
                  (nil? m) nil
                  (string? m) m
                  :else (m (:item event)))
       :confirm-label (or (:label action) "yes")
       :cancel-label "cancel"})))

(defn- apply-on-action [opts state action-event]
  ;; :on-action keeps the loop alive: run the caller's handler, swap in any
  ;; items it returns (preserving cursor/filter), show its status, and keep
  ;; browsing. Without a handler, return the action event and exit as before.
  (let [handler (:on-action opts)
        state (assoc state :mode :list :confirm nil :pending-action nil)]
    (if handler
      (let [result (or (handler action-event) {})
            state (assoc state :status (:status result))
            list (if (contains? result :items)
                   (tlist/set-items (:list state) (:items result))
                   (:list state))]
        [(assoc state :list (tlist/reconcile-offset list (list-height opts state)))
         nil])
      [state action-event])))

(defn- select-update [opts state msg]
  ;; Clear the transient status on any key, so an :on-action status survives
  ;; exactly until the next keypress.
  (let [state (assoc state :status nil)]
    (if (= :confirm (:mode state))
      ;; confirmation owns every key while open
      (let [r (tconfirm/update (:confirm state) msg)
            event (second r)]
        (cond
          (nil? event) [(assoc state :confirm (first r)) nil]
          (:value event) (apply-on-action opts state
                                          (assoc (:pending-action state) :confirmed? true))
          :else [(assoc state :mode :list :confirm nil :pending-action nil) nil]))
      (let [r (tlist/update (:list state) msg)
            event (second r)
            state (assoc state :list (tlist/reconcile-offset
                                       (first r) (list-height opts state)))
            action (when (= :action (:type event)) (action-config opts event))]
        (cond
          (and action (needs-confirm? action))
          [(assoc state
                  :mode :confirm
                  :confirm (confirm-for-action action event)
                  :pending-action event)
           nil]
          ;; A :returns? action exits select with its event even when
          ;; :on-action is set — for actions that must run outside the loop
          ;; (e.g. prompt for input, then re-enter).
          (and action (:returns? action)) [state event]
          (= :action (:type event)) (apply-on-action opts state event)
          :else [state event])))))

(defn select
  "Show a navigable list and return the user's choice:
     {:type :select :item item :index n}                on enter
     {:type :action :action id :item item :index n
      :destructive? true (when set)}                    on an action key
     {:type :cancel}                                    on q / esc / Ctrl-C
   An action with :confirm? or :destructive? set first opens a yes/no
   confirmation (configured by its :confirm-title and :confirm-message —
   a string or a fn of the item); the accepted action event carries
   :confirmed? true.
   With :on-action (fn [action-event] -> {:items new-items :status \"...\"}),
   an action does not return: the handler runs, any :items it returns replace
   the list in place (cursor and filter preserved), its :status shows until
   the next keypress, and the loop continues. Enter and cancel still exit.
   The handler is the caller's code (it may be impure); the widgets stay pure.
   An action with :returns? true is exempt: even under :on-action it returns
   its event (exits select), for work that must happen outside the loop —
   prompt for input, create something, then re-enter.
   :cursor-item starts the cursor on the row equal to it (else the top) —
   handy for re-entering focused on a just-added item. :status seeds a status
   line shown until the first key — e.g. feedback carried in from a prior
   action.
   opts: :title, :items, :item->text, :actions, :cursor-item, :status,
   :filterable?,
   :filter-fn (see tiny-tui.list/create), :inline? (render in place, erasing
   on exit — see run), plus the run testing hooks (:read-key-fn :render-fn
   :screen).
   With :filterable? the user types to narrow the list; letter keys type
   into the query, so bind actions to control keys (e.g. :key :ctrl-d) for
   them to fire while filtering — plain-letter actions are shadowed.
   With :multi? space toggles a checkbox on the current row and enter returns
   {:type :submit :items [...] :indices [...]} (see tui/multi-select)."
  [opts]
  (let [result (run {:init {:mode :list
                            :list (tlist/create opts)
                            ;; A seed status line shown until the first key —
                            ;; e.g. feedback carried in from a prior action.
                            :status (:status opts)}
                     :update (fn [state msg] (select-update opts state msg))
                     :view (fn [state] (select-view opts state))
                     :inline? (:inline? opts)
                     :read-key-fn (:read-key-fn opts)
                     :render-fn (:render-fn opts)
                     :screen (:screen opts)})
        event (second result)]
    (if (map? event)
      event
      {:type :cancel})))

(defn multi-select
  "Show a checkbox list (space toggles, enter submits) and return the vector
   of chosen items in list order — nil on cancel (esc/Ctrl-C/end of input),
   or [] on an empty submit. Takes the same opts as select (including
   :filterable?, which composes)."
  [opts]
  (let [result (select (assoc opts :multi? true))]
    (if (= :submit (:type result))
      (:items result)
      nil)))

(defn confirm
  "Ask a yes/no question and return a plain boolean. Cancelling (esc, q,
   Ctrl-C, end of input) returns false.
   opts: :title, :message, :confirm-label, :cancel-label (see
   tiny-tui.confirm/create), :inline? (render in place, erasing on exit —
   see run), plus the run testing hooks."
  [opts]
  (let [result (run {:init {:confirm (tconfirm/create opts)}
                     :update (fn [state msg]
                               (let [r (tconfirm/update (:confirm state) msg)]
                                 [(assoc state :confirm (first r)) (second r)]))
                     :view (fn [state]
                             (layout/vstack
                               (tconfirm/view (:confirm state))
                               ""
                               (help/view confirm-bindings)))
                     :inline? (:inline? opts)
                     :read-key-fn (:read-key-fn opts)
                     :render-fn (:render-fn opts)
                     :screen (:screen opts)})
        event (second result)]
    (if (map? event)
      (boolean (:value event))
      false)))

(def ^:private input-bindings
  [{:key "enter"
    :label "submit"}
   {:key "esc"
    :label "cancel"}])

(defn input
  "Prompt for a single line of text. Returns the entered string on submit,
   or nil on cancel (esc, Ctrl-C, end of input). An empty but submitted
   field returns \"\", distinct from a cancel's nil.
   opts: :title, :placeholder, :value, :validate (fn text -> error-string
   or nil; see tiny-tui.input/create), :inline? (render in place, erasing
   on exit — see run), plus the run testing hooks."
  [opts]
  (let [result (run {:init {:input (tinput/create opts)}
                     :update (fn [state msg]
                               (let [r (tinput/update (:input state) msg)]
                                 [(assoc state :input (first r)) (second r)]))
                     :view (fn [state]
                             (layout/vstack
                               (tinput/view (:input state))
                               ""
                               (help/view input-bindings)))
                     :inline? (:inline? opts)
                     :read-key-fn (:read-key-fn opts)
                     :render-fn (:render-fn opts)
                     :screen (:screen opts)})
        event (second result)]
    (if (and (map? event) (= :submit (:type event)))
      (:text event)
      nil)))
