;; tiny-tui.input — a pure single-line text input widget. State in,
;; [state event] out, string view. No terminal access; the caller (run)
;; owns I/O.
;;
;; Unlike list/confirm, printable keys — including "q" — are inserted as
;; text; only :esc cancels. Enter runs an optional :validate fn: a non-nil
;; result is shown as an inline error and blocks submit; nil submits.
;;
;; Optional autocomplete: a caller feeds candidate strings via
;; set-suggestions; :up/:down move the highlight and :tab replaces the text
;; with the highlighted candidate. The widget stays pure — it renders and
;; navigates suggestions but never computes them (see tiny-tui.path for the
;; filesystem helper and the :suggest-fn wiring in core).

(ns tiny-tui.input
  (:require [tiny-tui.layout :as layout]
            [tiny-tui.style :as style]))

(defn create
  "opts: {:title \"...\" :placeholder \"...\" :value \"initial\"
          :validate (fn [text] error-string-or-nil)}
   The cursor starts at the end of any initial :value. Suggestions start
   empty; a caller feeds them via set-suggestions (e.g. from a :suggest-fn)."
  [opts]
  (let [text (or (:value opts) "")]
    {:title (:title opts)
     :text text
     :cursor (count text)
     :placeholder (:placeholder opts)
     :validate (:validate opts)
     :error nil
     :suggestions []
     :suggestion-cursor 0}))

(defn set-suggestions
  "Replace the suggestion list (full replacement texts, not fragments) and
   reset the highlight to the first row. Pure: the caller computes the
   candidates; the widget only renders and navigates them."
  [s suggestions]
  (assoc s :suggestions (vec suggestions) :suggestion-cursor 0))

(defn- insert [s ins]
  (let [{:keys [text cursor]} s]
    (assoc s
           :text (str (subs text 0 cursor) ins (subs text cursor))
           :cursor (+ cursor (count ins))
           :error nil)))

(defn- backspace [s]
  (let [{:keys [text cursor]} s]
    (if (pos? cursor)
      (assoc s
             :text (str (subs text 0 (dec cursor)) (subs text cursor))
             :cursor (dec cursor)
             :error nil)
      (assoc s :error nil))))

(defn- delete-forward [s]
  (let [{:keys [text cursor]} s]
    (if (< cursor (count text))
      (assoc s
             :text (str (subs text 0 cursor) (subs text (inc cursor)))
             :error nil)
      (assoc s :error nil))))

(defn- move [s cursor]
  (assoc s :cursor (max 0 (min (count (:text s)) cursor)) :error nil))

(defn- word-char-at? [text i]
  ;; A word char is an ASCII letter or digit. Non-ASCII letters count as
  ;; separators — an accepted v1 limitation, so "/foo/bar-baz" jumps per path
  ;; segment (matching macOS text fields); Unicode-aware boundaries are a
  ;; follow-up.
  (let [c (int (first (seq (subs text i (inc i)))))]
    (or (<= 48 c 57) (<= 65 c 90) (<= 97 c 122))))

(defn- prev-word-start [text pos]
  ;; Walk left from pos: skip trailing separators, then the word chars before
  ;; them, returning the index where the previous word begins.
  (let [after-seps (loop [i pos]
                     (if (and (pos? i) (not (word-char-at? text (dec i))))
                       (recur (dec i))
                       i))]
    (loop [i after-seps]
      (if (and (pos? i) (word-char-at? text (dec i)))
        (recur (dec i))
        i))))

(defn- next-word-end [text pos]
  ;; Walk right from pos: skip leading separators, then the word chars after
  ;; them, returning the index just past the next word.
  (let [len (count text)
        after-seps (loop [i pos]
                     (if (and (< i len) (not (word-char-at? text i)))
                       (recur (inc i))
                       i))]
    (loop [i after-seps]
      (if (and (< i len) (word-char-at? text i))
        (recur (inc i))
        i))))

(defn- delete-region [s start end]
  ;; Drop text[start,end), leaving the cursor at start and clearing :error.
  (let [text (:text s)]
    (assoc s
           :text (str (subs text 0 start) (subs text end))
           :cursor start
           :error nil)))

(defn- backspace-word [s]
  (delete-region s (prev-word-start (:text s) (:cursor s)) (:cursor s)))

(defn- delete-word [s]
  (delete-region s (:cursor s) (next-word-end (:text s) (:cursor s))))

(defn- submit [s]
  ;; Run :validate (when set) on the current text. A non-nil result blocks
  ;; submit and becomes the inline error; nil emits the :submit event.
  (let [error (when-let [v (:validate s)] (v (:text s)))]
    (if error
      [(assoc s :error error) nil]
      [s {:type :submit
          :text (:text s)}])))

(defn- move-suggestion [s delta]
  ;; Slide the highlight within [0, count-1] (no wrap, matching the list
  ;; widget's edges). A no-op when there are no suggestions.
  (let [n (count (:suggestions s))]
    (if (zero? n)
      s
      (assoc s :suggestion-cursor
             (max 0 (min (dec n) (+ (:suggestion-cursor s) delta)))))))

(defn- accept-suggestion [s]
  ;; Replace the text with the highlighted suggestion, caret at the end,
  ;; error cleared. A no-op when there are no suggestions (tab does nothing).
  (if (empty? (:suggestions s))
    s
    (let [text (nth (:suggestions s) (:suggestion-cursor s))]
      (assoc s :text text :cursor (count text) :error nil))))

(defn update
  "Returns [new-state event]. Printable strings insert at the cursor;
   :backspace/:delete edit; :backspace-word/:ctrl-w delete the word before the
   caret and :delete-word the word after it; :left/:right/:home/:end move the
   caret and :word-left/:word-right jump by a word (ASCII letters/digits are
   word chars, so path segments count); :up/:down move the suggestion highlight
   (a no-op without suggestions); :tab accepts the highlighted suggestion;
   :enter submits (subject to :validate); :esc cancels. Editing, motion, and
   tab-accept emit no event."
  [s msg]
  (cond
    (string? msg) [(insert s msg) nil]
    (= msg :backspace) [(backspace s) nil]
    (= msg :delete) [(delete-forward s) nil]
    (= msg :backspace-word) [(backspace-word s) nil]
    (= msg :ctrl-w) [(backspace-word s) nil]
    (= msg :delete-word) [(delete-word s) nil]
    (= msg :left) [(move s (dec (:cursor s))) nil]
    (= msg :right) [(move s (inc (:cursor s))) nil]
    (= msg :word-left) [(move s (prev-word-start (:text s) (:cursor s))) nil]
    (= msg :word-right) [(move s (next-word-end (:text s) (:cursor s))) nil]
    (= msg :home) [(move s 0) nil]
    (= msg :end) [(move s (count (:text s))) nil]
    (= msg :down) [(move-suggestion s 1) nil]
    (= msg :up) [(move-suggestion s -1) nil]
    (= msg :tab) [(accept-suggestion s) nil]
    (= msg :enter) (submit s)
    (= msg :esc) [s {:type :cancel}]
    :else [s nil]))

(defn- field-str [s]
  ;; Draw our own caret as a static inverse-video block, since the run loop
  ;; keeps the real terminal cursor hidden. This is intentional: it does not
  ;; blink (using the real cursor would, but that means threading caret
  ;; coordinates out to the renderer — out of scope for this pure widget).
  ;; Empty text shows the dim placeholder behind a leading cursor block;
  ;; otherwise the char under the cursor is inverted, with a trailing inverse
  ;; space when the cursor is at the end.
  (let [text (:text s)
        cursor (:cursor s)
        len (count text)]
    (if (zero? len)
      (str (style/inverse " ")
           (when (:placeholder s) (style/dim (:placeholder s))))
      (let [before (subs text 0 cursor)
            at (if (< cursor len) (subs text cursor (inc cursor)) " ")
            after (if (< cursor len) (subs text (inc cursor)) "")]
        (str before (style/inverse at) after)))))

(defn- suggestion-lines [s]
  ;; One row per suggestion: the highlighted row carries the "› " marker
  ;; (indented to nest under the field) and inverse text; the rest are
  ;; indented to align and dimmed — mirroring the list widget's cursor row.
  (let [cursor (:suggestion-cursor s)]
    (map-indexed (fn [i text]
                   (if (= i cursor)
                     (str "  › " (style/inverse text))
                     (str "    " (style/dim text))))
                 (:suggestions s))))

(defn view
  "Render the input: optional bold title, the field with its block cursor, a
   red error line when a validation error is pending, and — after a blank
   separator — one row per suggestion, the highlighted one marked and inverse."
  [s]
  (apply layout/vstack
         (concat
           (when (:title s) [(style/bold (:title s)) ""])
           [(field-str s)]
           (when (:error s) ["" (style/fg :red (:error s))])
           (when (seq (:suggestions s)) (cons "" (suggestion-lines s))))))
